{
  "description": "I08 event detail adapters: each interface constructed with its defaults and with a full init dictionary, the interface name of every constructible event, and engine-dispatched payloads. tests/abi/event_details_browser.mjs records the Chromium oracle; tests/abi/event_details.py and the managed conformance suite compare with it.",
  "eventInit": {"bubbles": true, "cancelable": true, "composed": true},
  "constructed": [
    {"interface": "ErrorEvent", "native": "error_event", "type": "error",
     "fields": {"message": "string", "filename": "string", "lineno": "uint32", "colno": "uint32"},
     "init": {"message": "boom", "filename": "https://app.test/a.js", "lineno": 3, "colno": 4}},
    {"interface": "ProgressEvent", "native": "progress_event", "type": "progress",
     "fields": {"lengthComputable": "bool", "loaded": "double", "total": "double"},
     "init": {"lengthComputable": true, "loaded": 5, "total": 10}},
    {"interface": "AnimationEvent", "native": "css_animation_event", "type": "animationend",
     "fields": {"animationName": "string", "elapsedTime": "double", "pseudoElement": "string"},
     "init": {"animationName": "spin", "elapsedTime": 1.5, "pseudoElement": "::before"}},
    {"interface": "TransitionEvent", "native": "css_transition_event", "type": "transitionend",
     "fields": {"propertyName": "string", "elapsedTime": "double", "pseudoElement": "string"},
     "init": {"propertyName": "opacity", "elapsedTime": 0.25, "pseudoElement": "::after"}},
    {"interface": "ContentVisibilityAutoStateChangeEvent", "native": "content_visibility_auto_state_change_event", "type": "contentvisibilityautostatechange",
     "fields": {"skipped": "bool"},
     "init": {"skipped": true}},
    {"interface": "AnimationPlaybackEvent", "native": "animation_playback_event", "type": "finish",
     "fields": {"currentTime": "numberish", "timelineTime": "numberish"},
     "init": {"currentTime": 12, "timelineTime": 34}},
    {"interface": "PageTransitionEvent", "native": "page_transition_event", "type": "pageshow",
     "fields": {"persisted": "bool"},
     "init": {"persisted": true}},
    {"interface": "HashChangeEvent", "native": "hash_change_event", "type": "hashchange",
     "fields": {"oldURL": "string", "newURL": "string"},
     "init": {"oldURL": "https://app.test/#one", "newURL": "https://app.test/#two"}},
    {"interface": "MediaQueryListEvent", "native": "media_query_list_event", "type": "change",
     "fields": {"media": "string", "matches": "bool"},
     "init": {"media": "(min-width: 300px)", "matches": true}},
    {"interface": "PopStateEvent", "native": "pop_state_event", "type": "popstate",
     "fields": {"hasUAVisualTransition": "bool"},
     "init": {"hasUAVisualTransition": true}},
    {"interface": "CompositionEvent", "native": "composition_event", "type": "compositionupdate",
     "fields": {"data": "string", "detail": "int32"},
     "init": {"data": "ka", "detail": 2}}
  ],
  "typeQuery": [
    {"interface": "Event", "construct": "rv", "kind": 0},
    {"interface": "CustomEvent", "construct": "rv", "kind": 1},
    {"interface": "UIEvent", "construct": "rv", "kind": 2},
    {"interface": "MouseEvent", "construct": "rv", "kind": 3},
    {"interface": "KeyboardEvent", "construct": "rv", "kind": 4},
    {"interface": "FocusEvent", "construct": "rv", "kind": 5},
    {"interface": "SubmitEvent", "construct": "dom", "native": "submit_event"},
    {"interface": "FormDataEvent", "construct": "dom", "native": "form_data_event"},
    {"interface": "ToggleEvent", "construct": "dom", "native": "toggle_event"},
    {"interface": "CommandEvent", "construct": "dom", "native": "command_event"}
  ],
  "deferred": [
    {"members": ["MessageEvent", "PromiseRejectionEvent"], "reason": "fields of type any, MessagePort and Promise need script values", "owner": "messaging / script value groups"},
    {"members": ["StorageEvent"], "reason": "storageArea is a Storage handle", "owner": "web storage group"},
    {"members": ["ClipboardEvent", "DragEvent"], "reason": "clipboardData and dataTransfer are DataTransfer handles", "owner": "clipboard and drag-and-drop groups"},
    {"members": ["CloseEvent"], "reason": "WebSockets live under Modules/, which the generator skips", "owner": "networking group"},
    {"members": ["TextEvent"], "reason": "legacy, no constructor; reported as UIEvent by the type query", "owner": "input/IME group"},
    {"members": ["SecurityPolicyViolationEvent"], "reason": "not a UI event detail; kept out to keep I08 tight", "owner": "security policy group"},
    {"members": ["ErrorEvent.error", "ErrorEventInit.error", "PopStateEvent.state", "PopStateEventInit.state"], "reason": "type any needs a script value", "owner": "script value group"},
    {"members": ["AnimationEvent.animation", "TransitionEvent.animation", "AnimationEventInit.animation", "TransitionEventInit.animation"], "reason": "CSSAnimation and CSSTransition handles", "owner": "Web Animations group"}
  ],
  "dispatched": {
    "viewport": [400, 300],
    "markup": "<!doctype html><html><head><style>body{margin:0}@keyframes spin{from{opacity:0}to{opacity:1}}#a{width:10px;height:10px}#a.run{animation:spin 50ms linear 1}#b::before{content:'x';animation:spin 0s linear 1}#t{width:10px;height:10px;opacity:1;transition:opacity 50ms linear}#t.off{opacity:0}#cv{content-visibility:auto;contain-intrinsic-size:auto 10px}#button{position:absolute;left:100px;top:20px;width:80px;height:30px}#field{position:absolute;left:100px;top:60px;width:80px;height:24px}#scroller{position:absolute;left:200px;top:20px;width:100px;height:60px;overflow:auto}#filler{height:4000px}</style></head><body><div id=a></div><div id=b></div><div id=t></div><button id=button>b</button><input id=field><div id=scroller><div style='height:400px'></div></div><dialog id=dialog>d</dialog><img id=img src='https://missing.invalid/x.png'><div id=filler></div><div id=cv>c</div></body></html>",
    "types": ["pageshow", "animationstart", "animationend", "transitionrun", "transitionstart", "transitionend", "contentvisibilityautostatechange", "change", "error", "toggle", "beforetoggle", "pointerdown", "mousedown", "pointerup", "mouseup", "click", "wheel", "keydown", "beforeinput", "input", "keyup", "focus", "focusin"],
    "fields": {
      "PageTransitionEvent": ["persisted"],
      "AnimationEvent": ["animationName", "elapsedTime", "pseudoElement"],
      "TransitionEvent": ["propertyName", "elapsedTime", "pseudoElement"],
      "ContentVisibilityAutoStateChangeEvent": ["skipped"],
      "MediaQueryListEvent": ["media", "matches"],
      "ToggleEvent": ["oldState", "newState"],
      "PointerEvent": ["pointerType", "isPrimary", "button"],
      "MouseEvent": ["button", "detail"],
      "WheelEvent": ["deltaMode"],
      "KeyboardEvent": ["key", "code"],
      "InputEvent": ["data", "inputType"],
      "FocusEvent": []
    },
    "steps": [
      {"name": "load", "op": "load", "order": "set", "until": ["pageshow", "contentvisibilityautostatechange", "animationstart", "animationend", "error"]},
      {"name": "animation", "op": "class", "id": "a", "value": "run", "until": ["animationstart", "animationend"]},
      {"name": "transition", "op": "class", "id": "t", "value": "off", "until": ["transitionend"]},
      {"name": "media query change", "op": "resize", "width": 350, "height": 300, "media": "(min-width: 380px)", "until": ["change"]},
      {"name": "dialog show", "op": "dialogShow", "id": "dialog", "until": ["toggle"]},
      {"name": "click", "op": "click", "x": 140, "y": 35},
      {"name": "wheel", "op": "wheel", "x": 250, "y": 50, "deltaY": 40},
      {"name": "type", "op": "focusAndType", "id": "field", "x": 140, "y": 72, "key": "a", "code": "KeyA"}
    ]
  }
}
