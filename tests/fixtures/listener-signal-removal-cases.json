{
  "description": "Listener removal scenarios for AbortSignal-bound listeners (I01, WebCore #99). A group is one AbortController in Chromium and one set of RvListener handles natively; removing a group is abort() in Chromium and rv_listener_remove natively. Listeners with one label share one callback.",
  "scenarios": [
    {"name": "remove-later-during-dispatch",
     "listeners": [{"label": "A", "node": "child", "group": "g1", "onFire": [{"do": "remove", "group": "g2"}]},
                   {"label": "B", "node": "child", "group": "g2"}],
     "steps": [{"do": "dispatch", "node": "child"}, {"do": "dispatch", "node": "child"}],
     "expected": [["A"], ["A"]]},
    {"name": "remove-self-during-dispatch",
     "listeners": [{"label": "A", "node": "child", "group": "g1", "onFire": [{"do": "remove", "group": "g1"}]},
                   {"label": "B", "node": "child", "group": "g2"}],
     "steps": [{"do": "dispatch", "node": "child"}, {"do": "dispatch", "node": "child"}],
     "expected": [["A", "B"], ["B"]]},
    {"name": "remove-earlier-during-dispatch",
     "listeners": [{"label": "A", "node": "child", "group": "g1"},
                   {"label": "B", "node": "child", "group": "g2", "onFire": [{"do": "remove", "group": "g1"}]}],
     "steps": [{"do": "dispatch", "node": "child"}, {"do": "dispatch", "node": "child"}],
     "expected": [["A", "B"], ["B"]]},
    {"name": "add-during-dispatch",
     "listeners": [{"label": "A", "node": "child", "group": "g1",
                    "onFire": [{"do": "add", "once": true, "listener": {"label": "C", "node": "child", "group": "g2"}}]}],
     "steps": [{"do": "dispatch", "node": "child"}, {"do": "dispatch", "node": "child"}],
     "expected": [["A"], ["A", "C"]]},
    {"name": "capture-and-bubble-are-separate",
     "listeners": [{"label": "P", "node": "parent", "group": "g1", "capture": true},
                   {"label": "P", "node": "parent", "group": "g2"}],
     "steps": [{"do": "dispatch", "node": "child"}, {"do": "remove", "group": "g1"}, {"do": "dispatch", "node": "child"},
               {"do": "remove", "group": "g2"}, {"do": "dispatch", "node": "child"}],
     "expected": [["P", "P"], ["P"], []]},
    {"name": "duplicate-registration",
     "listeners": [{"label": "D", "node": "child", "group": "g1"},
                   {"label": "D", "node": "child", "group": "g2"}],
     "steps": [{"do": "dispatch", "node": "child"}, {"do": "remove", "group": "g2"}, {"do": "dispatch", "node": "child"},
               {"do": "remove", "group": "g1"}, {"do": "dispatch", "node": "child"}],
     "expected": [["D"], ["D"], []],
     "native": [["D", "D"], ["D"], []],
     "qualification": "Each rv_node_add_event_listener call is its own WebCore EventListener, so the ABI never deduplicates. The managed facade (Events.AddRegistered) deduplicates type, listener and capture before it calls the ABI, and its Listen adds nothing for a duplicate."},
    {"name": "group-removal-across-targets",
     "listeners": [{"label": "X", "node": "parent", "group": "g1"},
                   {"label": "Y", "node": "child", "group": "g1"},
                   {"label": "Z", "node": "child", "group": "g2"}],
     "steps": [{"do": "dispatch", "node": "child"}, {"do": "remove", "group": "g1"}, {"do": "dispatch", "node": "child"}],
     "expected": [["Y", "Z", "X"], ["Z"]]},
    {"name": "capture-removes-bubble-on-ancestor",
     "listeners": [{"label": "Pc", "node": "parent", "group": "g1", "capture": true, "onFire": [{"do": "remove", "group": "g2"}]},
                   {"label": "Pb", "node": "parent", "group": "g2"}],
     "steps": [{"do": "dispatch", "node": "child"}, {"do": "dispatch", "node": "child"}],
     "expected": [["Pc"], ["Pc"]]}
  ]
}
