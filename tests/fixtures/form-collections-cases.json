  "markup": "<!doctype html><body><form id=\"f\" name=\"main\"><input id=\"a1\" name=\"a\" value=\"1\"><input id=\"a2\" name=\"a\" value=\"2\"><input id=\"idonly\" value=\"i\"><input id=\"x\" name=\"y\" value=\"xy\"><input id=\"y\" name=\"z\" value=\"yz\"><fieldset id=\"fs\"><input id=\"inner\" name=\"inner\" value=\"in\"><output id=\"out\" name=\"out\">o</output></fieldset><input id=\"dis\" name=\"dis\" value=\"d\" disabled><input id=\"cb\" type=\"checkbox\" name=\"cb\" value=\"on\" checked><input id=\"cb2\" type=\"checkbox\" name=\"cb2\" value=\"off\"><input id=\"file\" type=\"file\" name=\"upload\"><input id=\"img\" type=\"image\" name=\"img\"><select id=\"s\" name=\"s\"><option id=\"o1\" value=\"v1\">One</option><optgroup id=\"g\" label=\"G\"><option id=\"o2\" name=\"two\">Two</option></optgroup><option id=\"o3\" value=\"v3\" selected>Three</option></select><textarea id=\"ta\" name=\"ta\">text</textarea><button id=\"b1\" name=\"go\" value=\"one\">Go</button><button id=\"b2\" type=\"button\" name=\"nb\">No</button><button id=\"b3\" type=\"reset\" name=\"rb\">Reset</button><input id=\"sub\" type=\"submit\" name=\"s2\" value=\"Send\"></form><input id=\"outside\" name=\"a\" value=\"3\" form=\"f\"><form id=\"f2\"><button id=\"other\" name=\"other\">Other</button></form><p id=\"p\"></p></body>",
