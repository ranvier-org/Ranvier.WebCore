+// A canvas renders its bitmap when script can run, or when it has a rendering context, which without script only an
+// embedder creates (Ranvier patch 00NN). Otherwise it renders its fallback content.
+static bool rendersBitmap(const HTMLCanvasElement& canvas)
+{
+    RefPtr frame = canvas.document().frame();
+    if (!frame)
+        return false;
+    return canvas.renderingContext() || protect(frame->script())->canExecuteScripts(ReasonForCallingCanExecuteScripts::NotAboutToExecuteScript);
+}
