            "0038-platform-screen-win-embedder-screen-data.patch": {
              "sha256": "a69004c7217489eb71e898c4ae737d1de99c855b2ec9ddfdcf99a1835ee4432e",
              "files": {
                "Source/WebCore/platform/PlatformScreen.cpp": [
                  "-#if PLATFORM(COCOA) || PLATFORM(GTK) || (PLATFORM(WPE) && ENABLE(WPE_PLATFORM))",
                  "+#if PLATFORM(COCOA) || PLATFORM(GTK) || (PLATFORM(WPE) && ENABLE(WPE_PLATFORM)) || PLATFORM(WIN)",
                  "-#endif // PLATFORM(COCOA) || PLATFORM(GTK) || (PLATFORM(WPE) && ENABLE(WPE_PLATFORM))",
                  "+#endif // PLATFORM(COCOA) || PLATFORM(GTK) || (PLATFORM(WPE) && ENABLE(WPE_PLATFORM)) || PLATFORM(WIN)"
                ],
                "Source/WebCore/platform/win/PlatformScreenWin.cpp": [
                  "+#include \"ScreenProperties.h\"",
                  "+// The screen an embedder set for the widget's display through PlatformScreen::updateSingletonProperties, as WPE and",
                  "+// Mac read it, or null.",
                  "+static const ScreenData* embedderScreenData(Widget* widget)",
                  "+{",
                  "+    if (!widget || !widget->root())",
                  "+        return nullptr;",
                  "+    auto* hostWindow = widget->root()->hostWindow();",
                  "+    if (!hostWindow || !hostWindow->displayID())",
                  "+        return nullptr;",
                  "+    return PlatformScreen::singleton()->screenData(hostWindow->displayID());",
                  "+}",
                  "+",
                  "+    if (auto* data = embedderScreenData(widget))",
                  "+        return data->screenDepth;",
                  "+    if (auto* data = embedderScreenData(widget))",
                  "+        return data->screenRect;",
                  "+    if (auto* data = embedderScreenData(widget))",
                  "+        return data->screenAvailableRect;"
                ]
              }
            },
