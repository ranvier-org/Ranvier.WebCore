  "defaultScreen": "every RID: the host size in CSS pixels, all of it available, depth 24, landscape-primary unless taller than wide; follows rv_host_resize until rv_host_set_screen (the host publishes it through PlatformScreen, which 0038 makes Windows read; WPE and Mac read it already)",
  "qualifications": [
    {
      "name": "orientation lock",
      "reason": "native locking stays off and reads Unsupported; Chromium headless resolves lock(portrait) without changing the type (oracle lock field)"
    },
    {
      "name": "angle",
      "reason": "the angle follows from the type on the natural landscape orientation (WebKit table); the app sets the type"
    },
    {
      "name": "event order",
      "reason": "the order of orientation change and resize events is never asserted"
    },
    {
      "name": "detached document",
      "reason": "a document kept past rv_host_destroy has no frame, and its Screen reports 0"
    },
    {
      "name": "browser size-only change",
      "reason": "Chromium fires no event for a screen size change without an orientation or viewport change, so the browser provider delivers changes it can observe"
    }
  ],
