+void ImageBitmap::createCompletionHandler(ScriptExecutionContext& scriptExecutionContext, ImageBitmap::Source&& source, ImageBitmapOptions&& options, int sx, int sy, int sw, int sh, ImageBitmapCompletionHandler&& completionHandler)
+{
+    if (!sw || !sh) {
+        completionHandler(Exception { ExceptionCode::RangeError, "Cannot create ImageBitmap with a width or height of 0"_s });
+        return;
+    }
+
+    auto left = sw >= 0 ? sx : sx + sw;
+    auto top = sh >= 0 ? sy : sy + sh;
+    auto width = std::abs(sw);
+    auto height = std::abs(sh);
+
+    WTF::switchOn(WTF::move(source),
+        [&](auto&& specificSource) {
+            createCompletionHandler(scriptExecutionContext, WTF::move(specificSource), WTF::move(options), IntRect { left, top, width, height }, WTF::move(completionHandler));
+        }
+    );
+}
