  "qualifications": [
    {
      "name": "secure context",
      "reason": "the native host exposes no page script, so randomUUID is available without [SecureContext]; a Fable provider in an insecure context reads randomUUID and digest as Unsupported"
    },
    {
      "name": "copied ranges",
      "reason": "the glue fills a copy of the caller bytes and copies it back, so a range needs no element alignment; a byte length that is not a multiple of the element size raises RangeError"
    },
    {
      "name": "after host destroy",
      "reason": "a retained document keeps its Window and crypto object, as a detached browser window does; both functions keep working (probe afterDestroy, teardown case \"crypto\")"
    },
    {
      "name": "random properties",
      "reason": "no random value is asserted: lengths, kinds, v4 format, version/variant bits, neighbour bytes untouched and two fills differing (probability 2^-128 of a false failure)"
    }
  ],
