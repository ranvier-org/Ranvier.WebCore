  "qualifications": [
    {
      "case": "parse[39]",
      "note": "A space is a forbidden host code point (WHATWG URL host parser): the engine fails, as the spec and WPT require; Chromium percent-encodes it."
    },
    {
      "case": "parse[44]",
      "note": "\"|\" is outside the path percent-encode set: the engine keeps it, as the spec does; Chromium encodes it as %7C."
    },
    {
      "case": "parse[53]",
      "note": "The engine keeps the drive letter case of file:c:\foo; Chromium uppercases it."
    },
    {
      "case": "parse[55]",
      "note": "The spec file-host state replaces the host \"localhost\" with the empty host: the engine does; Chromium keeps localhost."
    },
    {
      "case": "setters[3]",
      "note": "The protocol setter cannot turn a non-special scheme into a special one: the engine keeps mailto:, as the spec does; Chromium switches to https."
    },
    {
      "case": "setters[22]",
      "note": "Setting search to \"?\" sets an empty query, so href keeps the \"?\" (spec); Chromium drops it."
    },
    {
      "name": "WPT disagreements",
      "count": 150,
      "reason": "149 cases the engine passes and Chromium fails; urlpattern[347] is a JavaScript overload-conversion TypeError with no C ABI call"
    },
    {
      "name": "NUL-terminated sequences",
      "count": null,
      "reason": "URLSearchParams.getAll and the sequence<sequence<USVString>> init arm cut a value at U+0000; get, entries and the record and string arms keep it"
    }
