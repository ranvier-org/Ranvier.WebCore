 static bool s_paintsLayersOnGPU;
+// Whether layers painted on the GPU since setPaintsLayersOnGPU(true) have work the current context has not waited for.
+static bool s_unfinishedGPUPaints;
+
+// Submits the Skia context's paints and makes the current context wait for them on the GPU: once for all the layers
+// of a composite, rather than a flush, a fence and a wait for each.
+static void finishGPUPaints()
+{
+    s_unfinishedGPUPaints = false;
+    auto* compositingContext = GLContext::current();
+    auto& display = PlatformDisplay::sharedDisplay();
+    auto* skiaContext = display.skiaGLContext();
+    if (!compositingContext || !skiaContext)
+        return;
+    if (!skiaContext->makeContextCurrent()) {
+        compositingContext->makeContextCurrent();
+        return;
+    }
+    auto fence = SkiaUtilities::flushAndSubmitWithFence(display.skiaGrContext());
+    // The fence is waited on from the compositing context, and a wait without EGL_SYNC_FLUSH_COMMANDS_BIT on a fence
+    // its own context never flushed does not return (ANGLE's D3D11 backend spins on it).
+    glFlush();
+    if (!compositingContext->makeContextCurrent())
+        return;
+    if (fence)
+        fence->serverWait();
+}
 
 void BitmapTexture::setPaintsLayersOnGPU(bool enabled)
 {
+    if (!enabled && s_unfinishedGPUPaints)
+        finishGPUPaints();
     s_paintsLayersOnGPU = enabled;
 }
 
