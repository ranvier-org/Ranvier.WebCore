diff --git a/Source/ThirdParty/skia/GPUStub.cmake b/Source/ThirdParty/skia/GPUStub.cmake
new file mode 100644
index 0000000..44a338b
--- /dev/null
+++ b/Source/ThirdParty/skia/GPUStub.cmake
@@ -0,0 +1,10 @@
+# Skia without its GPU backends (USE_GPU_STUB): Ganesh, the GPU text and tessellation code, the SkSL
+# code generators for GPU shading languages, and the EGL interface. Raster drawing and the SkSL raster
+# pipeline remain. stub/GaneshStub.cpp defines the Ganesh entry points WebKit references.
+
+get_target_property(_skia_sources Skia SOURCES)
+list(FILTER _skia_sources EXCLUDE REGEX "^src/gpu/|^src/text/gpu/|^src/sksl/codegen/SkSL(GLSL|Metal|PipelineStage|SPIRV|WGSL)CodeGenerator\\.cpp$")
+set_property(TARGET Skia PROPERTY SOURCES ${_skia_sources})
+unset(_skia_sources)
+
+target_sources(Skia PRIVATE stub/GaneshStub.cpp)
