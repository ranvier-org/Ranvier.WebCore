diff --git a/Source/WebCore/platform/graphics/stub/GPUStub.cmake b/Source/WebCore/platform/graphics/stub/GPUStub.cmake
new file mode 100644
index 0000000..7dc8149
--- /dev/null
+++ b/Source/WebCore/platform/graphics/stub/GPUStub.cmake
@@ -0,0 +1,9 @@
+# WebCore without GPU rendering (USE_GPU_STUB): the TextureMapper compositor, EGL and GL contexts and
+# PlatformDisplay. GPUStub.cpp defines the members of these types that the remaining WebCore code
+# references; painting is raster only.
+
+list(FILTER WebCore_SOURCES EXCLUDE REGEX "^platform/graphics/(texmap|egl|angle)/|^platform/graphics/(win/)?PlatformDisplay(Win)?\.cpp$")
+
+list(APPEND WebCore_SOURCES
+    platform/graphics/stub/GPUStub.cpp
+)
diff --git a/Source/WebCore/platform/graphics/stub/GPUStub.cpp b/Source/WebCore/platform/graphics/stub/GPUStub.cpp
new file mode 100644
index 0000000..cfd6962
--- /dev/null
+++ b/Source/WebCore/platform/graphics/stub/GPUStub.cpp
@@ -0,0 +1,78 @@
+// Members of WebCore's GPU rendering types for a build without TextureMapper, EGL and PlatformDisplay
+// (USE_GPU_STUB).
+//
+// Painting is raster only: no GL context, fence, texture or composited layer exists, and a call that
+// requires one is a release assertion. GLFence reports itself unsupported.
+
+#include "config.h"
+
+#include "BitmapTexture.h"
+#include "GLContext.h"
+#include "GLContextWrapper.h"
+#include "GLDisplay.h"
+#include "GLFence.h"
+#include "GraphicsLayer.h"
+#include "PlatformDisplay.h"
+
+namespace WebCore {
+
+Ref<GraphicsLayer> GraphicsLayer::create(GraphicsLayerFactory*, GraphicsLayerClient&, Type)
+{
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+PlatformDisplay& PlatformDisplay::sharedDisplay()
+{
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+GLContextWrapper::~GLContextWrapper() = default;
+
+GLContext::~GLContext() = default;
+
+RefPtr<GLDisplay> GLContext::display() const
+{
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+bool GLContext::makeContextCurrent()
+{
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+GLContext::ScopedGLContextCurrent::ScopedGLContextCurrent(GLContext& context)
+    : m_context(context)
+{
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+GLContext::ScopedGLContextCurrent::~ScopedGLContextCurrent() = default;
+
+bool GLDisplay::runIfNotTerminated(NOESCAPE const Function<void(EGLDisplay)>&)
+{
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+bool GLFence::isSupported(const GLDisplay&)
+{
+    return false;
+}
+
+std::unique_ptr<GLFence> GLFence::create(const GLDisplay&)
+{
+    return nullptr;
+}
+
+BitmapTexture::~BitmapTexture() = default;
+
+void BitmapTexture::updateContents(const void*, const IntRect&, const IntPoint&, int, PixelFormat)
+{
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+GrBackendTexture BitmapTexture::createSkiaBackendTexture() const
+{
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+} // namespace WebCore
