+namespace WebCore {
+
+class Document;
+struct MediaDecodingConfiguration;
+struct MediaEncodingConfiguration;
+
+// MediaCapabilities.decodingInfo() and encodingInfo() for an embedder, without JavaScript or a promise.
+// An invalid configuration completes with TypeError before the call returns. A valid one completes with the
+// answer of the document's media engine configuration factories, from their callback, which can run before
+// the call returns.
+WEBCORE_EXPORT void queryMediaDecodingInfo(Document&, MediaDecodingConfiguration&&, Function<void(ExceptionOr<PlatformMediaCapabilitiesDecodingInfo>&&)>&&);
+WEBCORE_EXPORT void queryMediaEncodingInfo(Document&, MediaEncodingConfiguration&&, Function<void(ExceptionOr<PlatformMediaCapabilitiesEncodingInfo>&&)>&&);
+
+} // namespace WebCore
