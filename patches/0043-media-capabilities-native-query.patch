+++ b/Source/WebCore/Modules/mediacapabilities/MediaCapabilities.cpp
@@ -36,6 +36,7 @@
 #include "Logging.h"
 #include "MediaCapabilitiesDecodingInfo.h"
 #include "MediaCapabilitiesEncodingInfo.h"
+#include "MediaCapabilitiesNativeQuery.h"
 #include "MediaDecodingConfiguration.h"
 #include "MediaEncodingConfiguration.h"
 #include "NavigatorBase.h"
@@ -339,4 +340,26 @@ void MediaCapabilities::encodingInfo(ScriptExecutionContext& context, MediaEncod
     });
 }
 
+void queryMediaDecodingInfo(Document& document, MediaDecodingConfiguration&& configuration, Function<void(ExceptionOr<PlatformMediaCapabilitiesDecodingInfo>&&)>&& completion)
+{
+    if (!isValidMediaConfiguration(configuration)) {
+        completion(Exception { ExceptionCode::TypeError });
+        return;
+    }
+    gatherDecodingInfo(document, toPlatform(WTF::move(configuration)), [completion = WTF::move(completion)](PlatformMediaCapabilitiesDecodingInfo&& info) mutable {
+        completion(WTF::move(info));
+    });
+}
+
+void queryMediaEncodingInfo(Document& document, MediaEncodingConfiguration&& configuration, Function<void(ExceptionOr<PlatformMediaCapabilitiesEncodingInfo>&&)>&& completion)
+{
+    if (!isValidMediaConfiguration(configuration)) {
+        completion(Exception { ExceptionCode::TypeError });
+        return;
+    }
+    gatherEncodingInfo(document, toPlatform(WTF::move(configuration)), [completion = WTF::move(completion)](PlatformMediaCapabilitiesEncodingInfo&& info) mutable {
+        completion(WTF::move(info));
+    });
+}
+
 }
