+static thread_local const PointerEvent::PenGeometry* currentPenGeometry;
+
+auto PointerEvent::pendingPenGeometry() -> const PenGeometry*
+{
+    return currentPenGeometry;
+}
+
+PointerEvent::PendingPenGeometryScope::PendingPenGeometryScope(const PenGeometry& geometry)
+    : m_previous(currentPenGeometry)
+{
+    currentPenGeometry = &geometry;
+}
+
+PointerEvent::PendingPenGeometryScope::~PendingPenGeometryScope()
+{
+    currentPenGeometry = m_previous;
+}
+
+void PointerEvent::setPenGeometry(const PenGeometry& geometry)
+{
+    m_tiltX = geometry.tiltX;
+    m_tiltY = geometry.tiltY;
+    m_twist = geometry.twist;
+    m_tangentialPressure = geometry.tangentialPressure;
+    m_width = geometry.width;
+    m_height = geometry.height;
+    auto angle = angleFromTilt(m_tiltX, m_tiltY);
+    m_altitudeAngle = angle.altitudeAngle;
+    m_azimuthAngle = angle.azimuthAngle;
+    for (auto& coalesced : m_coalescedEvents)
+        coalesced->setPenGeometry(geometry);
+}
