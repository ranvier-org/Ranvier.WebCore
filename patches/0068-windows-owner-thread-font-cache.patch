 FontCache* FontCache::forCurrentThreadIfExists()
 {
+#if OS(WINDOWS)
+    auto* thread = Thread::currentMayBeNull();
+    if (!thread)
+        return nullptr;
+    auto* data = dynamicDowncast<ThreadGlobalData>(thread->m_clientData.get());
+    return data ? data->fontCacheIfExists() : nullptr;
+#else
     return threadGlobalDataSingleton().fontCacheIfExists();
+#endif
 }
 
