+static WeakHashMap<Page, int>& embedderTouchPoints()
+{
+    static NeverDestroyed<WeakHashMap<Page, int>> map;
+    return map;
+}
+
+void Navigator::setEmbedderMaxTouchPoints(Page& page, int value)
+{
+    if (value > 0)
+        embedderTouchPoints().set(page, value);
+    else
+        embedderTouchPoints().remove(page);
+}
+
+int Navigator::embedderMaxTouchPoints(const Page& page)
+{
+    auto iterator = embedderTouchPoints().find(page);
+    return iterator == embedderTouchPoints().end() ? 0 : iterator->value;
+}
