+        $interface->extendedAttributes->{LegacyNoInterfaceObject} = 1;
+        $interface->extendedAttributes->{InterfaceObjectStub} = 1;
+    }
+
     $codeGenerator->LinkOverloadedOperations($interface);
 
     AddIterableOperationIfNeeded($interface);
@@ -5371,6 +5377,10 @@ sub GenerateImplementation
