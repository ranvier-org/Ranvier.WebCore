+    AddToImplIncludes("JSDOMGlobalObjectInlines.h") if $interface->extendedAttributes->{InterfaceObjectStub};
+
     if (!$interface->extendedAttributes->{LegacyNoInterfaceObject}) {
         AddToImplIncludes("JSDOMGlobalObjectInlines.h");
