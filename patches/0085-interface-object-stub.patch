@@ -173,6 +173,12 @@ sub GenerateInterface
 {
     my ($object, $interface, $defines, $enumerations, $dictionaries) = @_;
 
+    # USE_INTERFACE_OBJECT_STUB: every interface is generated as one declared [LegacyNoInterfaceObject].
