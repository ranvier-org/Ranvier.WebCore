+void MainThreadSharedTimer::fireIfDue()
+{
+    if (!armedFireTime || armedFireTime > MonotonicTime::now())
+        return;
+
+    // The caller is outside the message loop, so this post cannot keep a loop that drains the queue from ending.
+    // stop() cancels the timer-queue timer or WM_TIMER; pendingTimers keeps a callback already running from
+    // posting a second message.
+    singleton().stop();
+    if (InterlockedIncrement(&pendingTimers) == 1)
+        PostMessage(timerWindowHandle, timerFiredMessage, 0, 0);
+}
