diff --git a/Source/ThirdParty/ANGLE/Stub.cmake b/Source/ThirdParty/ANGLE/Stub.cmake
new file mode 100644
index 000000000..93c4b76b2
--- /dev/null
+++ b/Source/ThirdParty/ANGLE/Stub.cmake
@@ -0,0 +1,22 @@
+# ANGLE::EGL and ANGLE::GLES over stub/ANGLEStub.cpp instead of ANGLE, for builds without a GPU.
+add_library(ANGLEStub STATIC stub/ANGLEStub.cpp)
+add_dependencies(ANGLEStub ANGLEHeaders)
+target_include_directories(ANGLEStub PRIVATE ${ANGLE_FRAMEWORK_HEADERS_DIR} ${ANGLE_HEADERS_DIR})
+target_compile_definitions(ANGLEStub PRIVATE ${gl_prototypes} KHRONOS_STATIC)
+
+add_library(GLESv2Framework INTERFACE)
+target_link_libraries(GLESv2Framework INTERFACE ANGLEStub)
+target_include_directories(GLESv2Framework INTERFACE ${ANGLE_FRAMEWORK_HEADERS_DIR} ${ANGLE_HEADERS_DIR})
+target_compile_definitions(GLESv2Framework INTERFACE USE_SYSTEM_EGL KHRONOS_STATIC)
+add_dependencies(GLESv2Framework GLSLANGHeaders ANGLEHeaders)
+add_library(ANGLE::GLES ALIAS GLESv2Framework)
+
+add_library(EGLFramework INTERFACE)
+target_link_libraries(EGLFramework INTERFACE ANGLEStub)
+target_include_directories(EGLFramework INTERFACE ${ANGLE_FRAMEWORK_HEADERS_DIR}/ ${ANGLE_HEADERS_DIR})
+target_compile_definitions(EGLFramework INTERFACE ${gl_prototypes} KHRONOS_STATIC)
+add_dependencies(EGLFramework GLSLANGHeaders ANGLEHeaders)
+add_library(ANGLE::EGL ALIAS EGLFramework)
+
+target_include_directories(ANGLEFramework INTERFACE ${ANGLE_FRAMEWORK_HEADERS_DIR} ${ANGLE_HEADERS_DIR})
+add_library(ANGLE::ANGLE ALIAS ANGLEFramework)
