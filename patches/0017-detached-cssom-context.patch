+CSSRule::CSSRule(CSSStyleSheet* parent)
+    : m_hasCachedSelectorText(false)
+    , m_parentIsRule(false)
+    , m_parentStyleSheet(parent)
+{
+    rememberBindingsContext(false);
+}
+
+CSSRule::~CSSRule() = default;
+
+Document* CSSRule::documentForBindings() const
+{
+    if (auto* rule = parentRule())
+        return rule->documentForBindings();
+    if (auto* sheet = parentStyleSheet()) {
+        auto& root = sheet->rootStyleSheet();
+        if (auto* node = root.ownerNode())
+            return &node->document();
+        if (auto* document = root.constructorDocument())
+            return document;
+        if (auto* scope = root.styleScope())
+            return &scope->document();
+    }
+    return m_bindingsContext ? m_bindingsContext->document.get() : nullptr;
+}
+
+void CSSRule::rememberBindingsContext(bool preserveParserContext)
+{
+    if (preserveParserContext) {
+        if (!m_bindingsContext)
+            m_bindingsContext = makeUnique<BindingsContext>();
+        m_bindingsContext->parserContext = makeUnique<CSSParserContext>(parserContext());
+        return;
+    }
+    auto* document = documentForBindings();
+    if (!document)
+        return;
+    if (!m_bindingsContext)
+        m_bindingsContext = makeUnique<BindingsContext>();
+    m_bindingsContext->document = document;
+}
+
+bool CSSRule::prepareForDetachedDescriptorMutation()
+{
+    if (auto* rule = dynamicDowncast<CSSPositionTryRule>(*this)) {
+        if (!rule->positionTryRule().hasOneRef()) {
+            Ref copy = rule->positionTryRule().copy();
+            reattach(copy.get());
+        }
+        return true;
+    }
+    if (auto* rule = dynamicDowncast<CSSFontFaceRule>(*this)) {
+        if (!rule->m_fontFaceRule->hasOneRef()) {
+            Ref copy = rule->m_fontFaceRule->copy();
+            reattach(copy.get());
+        }
+        return true;
+    }
+    return false;
+}
+
+void CSSRule::setParentStyleSheet(CSSStyleSheet* styleSheet)
+{
+    rememberBindingsContext(true);
+    m_parentIsRule = false;
+    m_parentStyleSheet = styleSheet;
+    if (styleSheet) {
+        if (m_bindingsContext) {
+            m_bindingsContext->document = nullptr;
+            m_bindingsContext->parserContext = nullptr;
+        }
+        rememberBindingsContext(false);
+    }
+}
+
+void CSSRule::setParentRule(CSSRule* rule)
+{
+    rememberBindingsContext(true);
+    m_parentIsRule = true;
+    m_parentRule = rule;
+    if (rule) {
+        if (m_bindingsContext) {
+            m_bindingsContext->document = nullptr;
+            m_bindingsContext->parserContext = nullptr;
+        }
+        rememberBindingsContext(false);
+    }
+}
