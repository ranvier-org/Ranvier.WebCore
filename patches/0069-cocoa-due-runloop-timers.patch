+void RunLoop::dispatchDueTimers()
+{
+    releaseAssertIsCurrent(*this);
+    AutodrainedPool pool;
+    auto cutoff = CFAbsoluteTimeGetCurrent();
+    struct DueTimer {
+        TimerBase* timer;
+        RetainPtr<CFRunLoopTimerRef> cfTimer;
+        CFAbsoluteTime fireDate;
+    };
+    Vector<DueTimer, 64> due;
+    {
+        Locker locker { m_registeredTimerLock };
+        for (auto* timer : m_registeredTimers) {
+            auto cfTimer = timer->m_timer;
+            if (!cfTimer || timerCalloutIsActive(cfTimer.get()) || !CFRunLoopTimerIsValid(cfTimer.get()))
+                continue;
+            auto fireDate = CFRunLoopTimerGetNextFireDate(cfTimer.get());
+            if (fireDate > cutoff)
+                continue;
+            size_t index = 0;
+            while (index < due.size() && due[index].fireDate <= fireDate)
+                ++index;
+            if (index == 64)
+                continue;
+            if (due.size() == 64)
+                due.removeLast();
+            due.insert(index, DueTimer { timer, WTF::move(cfTimer), fireDate });
+        }
+    }
+    for (auto& candidate : due) {
+        auto* timer = candidate.timer;
+        auto& cfTimer = candidate.cfTimer;
+        {
+            Locker locker { m_registeredTimerLock };
+            if (!m_registeredTimers.contains(timer) || timer->m_timer != cfTimer || timerCalloutIsActive(cfTimer.get()) || !CFRunLoopTimerIsValid(cfTimer.get()))
+                continue;
+            auto nextFireDate = CFRunLoopTimerGetNextFireDate(cfTimer.get());
+            if (nextFireDate > cutoff)
+                continue;
+            auto interval = CFRunLoopTimerGetInterval(cfTimer.get());
+            if (interval > 0) {
+                auto now = CFAbsoluteTimeGetCurrent();
+                auto intervals = std::floor((now - nextFireDate) / interval) + 1;
+                CFRunLoopTimerSetNextFireDate(cfTimer.get(), nextFireDate + intervals * interval);
+            } else
+                CFRunLoopTimerInvalidate(cfTimer.get());
+        }
+        TimerCallout callout { cfTimer.get(), activeTimerCallout };
+        SetForScope scope { activeTimerCallout, &callout };
+        timer->fired();
+    }
+}
