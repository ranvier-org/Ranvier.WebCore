+struct TimerCallout {
+    CFRunLoopTimerRef timer;
+    TimerCallout* previous;
+};
+
+static thread_local TimerCallout* activeTimerCallout;
+
+static bool timerCalloutIsActive(CFRunLoopTimerRef timer)
+{
+    for (auto* callout = activeTimerCallout; callout; callout = callout->previous) {
+        if (callout->timer == timer)
+            return true;
+    }
+    return false;
+}
 
