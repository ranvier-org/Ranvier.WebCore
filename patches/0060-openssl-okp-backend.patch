+std::optional<Vector<uint8_t>> CryptoAlgorithmX25519::platformDeriveBits(const CryptoKeyOKP& baseKey, const CryptoKeyOKP& publicKey)
+{
+    EvpPKeyPtr privateMaterial(EVP_PKEY_new_raw_private_key(EVP_PKEY_X25519, nullptr, baseKey.platformKey().span().data(), baseKey.keySizeInBytes()));
+    EvpPKeyPtr publicMaterial(EVP_PKEY_new_raw_public_key(EVP_PKEY_X25519, nullptr, publicKey.platformKey().span().data(), publicKey.keySizeInBytes()));
+    EvpPKeyCtxPtr context(privateMaterial ? EVP_PKEY_CTX_new(privateMaterial.get(), nullptr) : nullptr);
+    if (!context || !publicMaterial || EVP_PKEY_derive_init(context.get()) != 1 || EVP_PKEY_derive_set_peer(context.get(), publicMaterial.get()) != 1)
+        return std::nullopt;
+    Vector<uint8_t> result(32);
+    size_t size = result.size();
+    if (EVP_PKEY_derive(context.get(), result.mutableSpan().data(), &size) != 1 || size != result.size())
+        return std::nullopt;
+    return result;
+}
