+static bool isSmallOrderPoint(std::span<const uint8_t> point)
+{
+    // Encodings of the points of order 1, 2, 4 and 8, ignoring the sign bit,
+    // including the non-canonical encodings of y = 0 and y = 1.
+    static constexpr std::array<std::array<uint8_t, 32>, 7> smallOrderPoints { {
+        { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 },
+        { 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 },
+        { 0x26, 0xe8, 0x95, 0x8f, 0xc2, 0xb2, 0x27, 0xb0, 0x45, 0xc3, 0xf4, 0x89, 0xf2, 0xef, 0x98, 0xf0, 0xd5, 0xdf, 0xac, 0x05, 0xd3, 0xc6, 0x33, 0x39, 0xb1, 0x38, 0x02, 0x88, 0x6d, 0x53, 0xfc, 0x05 },
+        { 0xc7, 0x17, 0x6a, 0x70, 0x3d, 0x4d, 0xd8, 0x4f, 0xba, 0x3c, 0x0b, 0x76, 0x0d, 0x10, 0x67, 0x0f, 0x2a, 0x20, 0x53, 0xfa, 0x2c, 0x39, 0xcc, 0xc6, 0x4e, 0xc7, 0xfd, 0x77, 0x92, 0xac, 0x03, 0x7a },
+        { 0xec, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x7f },
+        { 0xed, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x7f },
+        { 0xee, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x7f },
+    } };
+
+    if (point.size() != 32)
+        return false;
+
+    return std::ranges::any_of(smallOrderPoints, [&](auto& smallOrderPoint) {
+        // The encoding is y in little-endian, with the top bit of the last byte holding the sign of x.
+        // Ignore that bit, so that each entry matches both points that share the same y.
+        return equalSpans(point.first(31), std::span { smallOrderPoint }.first(31)) && (point[31] & 0x7f) == smallOrderPoint[31];
+    });
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmEd25519::platformSign(const CryptoKeyOKP& key, const Vector<uint8_t>& data)
+{
+    EvpPKeyPtr platformKey(EVP_PKEY_new_raw_private_key(EVP_PKEY_ED25519, nullptr, key.platformKey().span().data(), key.keySizeInBytes()));
+    EvpDigestCtxPtr context(EVP_MD_CTX_new());
+    if (!platformKey || !context || EVP_DigestSignInit(context.get(), nullptr, nullptr, nullptr, platformKey.get()) != 1)
+        return Exception { ExceptionCode::OperationError };
+    Vector<uint8_t> result(64);
+    size_t size = result.size();
+    if (EVP_DigestSign(context.get(), result.mutableSpan().data(), &size, data.span().data(), data.size()) != 1 || size != result.size())
+        return Exception { ExceptionCode::OperationError };
+    return result;
+}
+
+ExceptionOr<bool> CryptoAlgorithmEd25519::platformVerify(const CryptoKeyOKP& key, const Vector<uint8_t>& signature, const Vector<uint8_t>& data)
+{
+    if (signature.size() != 64 || isSmallOrderPoint(key.platformKey().span()) || isSmallOrderPoint(signature.span().first(32)))
+        return false;
+    EvpPKeyPtr platformKey(EVP_PKEY_new_raw_public_key(EVP_PKEY_ED25519, nullptr, key.platformKey().span().data(), key.keySizeInBytes()));
+    EvpDigestCtxPtr context(EVP_MD_CTX_new());
+    if (!platformKey || !context || EVP_DigestVerifyInit(context.get(), nullptr, nullptr, nullptr, platformKey.get()) != 1)
+        return Exception { ExceptionCode::OperationError };
+    return EVP_DigestVerify(context.get(), signature.span().data(), signature.size(), data.span().data(), data.size()) == 1;
+}
+
+} // namespace WebCore
