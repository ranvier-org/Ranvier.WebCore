+static int typeForCurve(CryptoKeyOKP::NamedCurve curve)
+{
+    return curve == CryptoKeyOKP::NamedCurve::Ed25519 ? EVP_PKEY_ED25519 : EVP_PKEY_X25519;
+}
+
+static bool matchesAlgorithm(CryptoAlgorithmIdentifier identifier, CryptoKeyOKP::NamedCurve curve)
+{
+    return (identifier == CryptoAlgorithmIdentifier::Ed25519 && curve == CryptoKeyOKP::NamedCurve::Ed25519)
+        || (identifier == CryptoAlgorithmIdentifier::X25519 && curve == CryptoKeyOKP::NamedCurve::X25519);
+}
+
+static std::optional<Vector<uint8_t>> publicMaterial(EVP_PKEY* key)
+{
+    Vector<uint8_t> result(32);
+    size_t size = result.size();
+    if (EVP_PKEY_get_raw_public_key(key, result.mutableSpan().data(), &size) != 1 || size != result.size())
+        return std::nullopt;
+    return result;
+}
+
+bool CryptoKeyOKP::supportsNamedCurve()
+{
+    return true;
+}
+
+std::optional<CryptoKeyPair> CryptoKeyOKP::platformGeneratePair(CryptoAlgorithmIdentifier identifier, NamedCurve curve, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    if (!matchesAlgorithm(identifier, curve))
+        return std::nullopt;
+    EvpPKeyCtxPtr context(EVP_PKEY_CTX_new_id(typeForCurve(curve), nullptr));
+    EVP_PKEY* generated = nullptr;
+    if (!context || EVP_PKEY_keygen_init(context.get()) != 1 || EVP_PKEY_keygen(context.get(), &generated) != 1) {
+        EVP_PKEY_free(generated);
+        return std::nullopt;
+    }
+    EvpPKeyPtr key(generated);
+    auto publicData = publicMaterial(key.get());
+    Vector<uint8_t> privateData(32);
+    size_t size = privateData.size();
+    if (!publicData || EVP_PKEY_get_raw_private_key(key.get(), privateData.mutableSpan().data(), &size) != 1 || size != privateData.size()) {
+        OPENSSL_cleanse(privateData.mutableSpan().data(), privateData.size());
+        return std::nullopt;
+    }
+    auto publicKey = create(identifier, curve, CryptoKeyType::Public, WTF::move(*publicData), true, usages);
+    auto privateKey = create(identifier, curve, CryptoKeyType::Private, WTF::move(privateData), extractable, usages);
+    if (!publicKey || !privateKey)
+        return std::nullopt;
+    return CryptoKeyPair { WTF::move(publicKey), WTF::move(privateKey) };
+}
+
+bool CryptoKeyOKP::platformCheckPairedKeys(CryptoAlgorithmIdentifier identifier, NamedCurve curve, const Vector<uint8_t>& privateKey, const Vector<uint8_t>& publicKey)
+{
+    if (!matchesAlgorithm(identifier, curve) || privateKey.size() != 32 || publicKey.size() != 32)
+        return false;
+    EvpPKeyPtr key(EVP_PKEY_new_raw_private_key(typeForCurve(curve), nullptr, privateKey.span().data(), privateKey.size()));
+    if (!key)
+        return false;
+    auto derived = publicMaterial(key.get());
+    return derived && equalSpans(derived->span(), publicKey.span());
+}
+
+RefPtr<CryptoKeyOKP> CryptoKeyOKP::importSpki(CryptoAlgorithmIdentifier identifier, NamedCurve curve, Vector<uint8_t>&& keyData, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    if (!matchesAlgorithm(identifier, curve) || keyData.size() > static_cast<size_t>(std::numeric_limits<long>::max()))
+        return nullptr;
+    const unsigned char* input = keyData.span().data();
+    EvpPKeyPtr key(d2i_PUBKEY(nullptr, &input, static_cast<long>(keyData.size())));
+    if (!key || input != keyData.span().data() + keyData.size() || EVP_PKEY_id(key.get()) != typeForCurve(curve))
+        return nullptr;
+    auto material = publicMaterial(key.get());
+    if (!material)
+        return nullptr;
+    int length = i2d_PUBKEY(key.get(), nullptr);
+    if (length <= 0)
+        return nullptr;
+    Vector<uint8_t> canonical(length);
+    unsigned char* output = canonical.mutableSpan().data();
+    if (i2d_PUBKEY(key.get(), &output) != length || !equalSpans(canonical.span(), keyData.span()))
+        return nullptr;
+    return create(identifier, curve, CryptoKeyType::Public, WTF::move(*material), extractable, usages);
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoKeyOKP::exportSpki() const
+{
+    if (type() != CryptoKeyType::Public)
+        return Exception { ExceptionCode::InvalidAccessError };
+    EvpPKeyPtr key(EVP_PKEY_new_raw_public_key(typeForCurve(namedCurve()), nullptr, m_data.span().data(), m_data.size()));
+    int length = key ? i2d_PUBKEY(key.get(), nullptr) : 0;
+    if (length <= 0)
+        return Exception { ExceptionCode::OperationError };
+    Vector<uint8_t> result(length);
+    unsigned char* output = result.mutableSpan().data();
+    if (i2d_PUBKEY(key.get(), &output) != length)
+        return Exception { ExceptionCode::OperationError };
+    return result;
+}
+
+RefPtr<CryptoKeyOKP> CryptoKeyOKP::importPkcs8(CryptoAlgorithmIdentifier identifier, NamedCurve curve, Vector<uint8_t>&& keyData, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    if (!matchesAlgorithm(identifier, curve) || keyData.size() > static_cast<size_t>(std::numeric_limits<long>::max()))
+        return nullptr;
+    const unsigned char* input = keyData.span().data();
+    PKCS8PrivKeyInfoPtr info(d2i_PKCS8_PRIV_KEY_INFO(nullptr, &input, static_cast<long>(keyData.size())));
+    if (!info || input != keyData.span().data() + keyData.size())
+        return nullptr;
+    const ASN1_OBJECT* object = nullptr;
+    const X509_ALGOR* algorithm = nullptr;
+    if (PKCS8_pkey_get0(&object, nullptr, nullptr, &algorithm, info.get()) != 1)
+        return nullptr;
+    int parameterType = 0;
+    X509_ALGOR_get0(&object, &parameterType, nullptr, algorithm);
+    if (OBJ_obj2nid(object) != typeForCurve(curve) || parameterType != V_ASN1_UNDEF)
+        return nullptr;
+    input = keyData.span().data();
+    ASN1SequencePtr fields(d2i_ASN1_SEQUENCE_ANY(nullptr, &input, static_cast<long>(keyData.size())));
+    if (!fields || sk_ASN1_TYPE_num(fields.get()) < 3)
+        return nullptr;
+    auto* version = sk_ASN1_TYPE_value(fields.get(), 0);
+    if (ASN1_TYPE_get(version) != V_ASN1_INTEGER || ASN1_INTEGER_get(version->value.integer) != 0)
+        return nullptr;
+    EvpPKeyPtr key(EVP_PKCS82PKEY(info.get()));
+    if (!key || EVP_PKEY_id(key.get()) != typeForCurve(curve))
+        return nullptr;
+    Vector<uint8_t> material(32);
+    size_t size = material.size();
+    if (EVP_PKEY_get_raw_private_key(key.get(), material.mutableSpan().data(), &size) != 1 || size != material.size()) {
+        OPENSSL_cleanse(material.mutableSpan().data(), material.size());
+        return nullptr;
+    }
+    return create(identifier, curve, CryptoKeyType::Private, WTF::move(material), extractable, usages);
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoKeyOKP::exportPkcs8() const
+{
+    if (type() != CryptoKeyType::Private)
+        return Exception { ExceptionCode::InvalidAccessError };
+    EvpPKeyPtr key(EVP_PKEY_new_raw_private_key(typeForCurve(namedCurve()), nullptr, m_data.span().data(), m_data.size()));
+    PKCS8PrivKeyInfoPtr info(key ? EVP_PKEY2PKCS8(key.get()) : nullptr);
+    int length = info ? i2d_PKCS8_PRIV_KEY_INFO(info.get(), nullptr) : 0;
+    if (length <= 0)
+        return Exception { ExceptionCode::OperationError };
+    Vector<uint8_t> result(length);
+    unsigned char* output = result.mutableSpan().data();
+    if (i2d_PKCS8_PRIV_KEY_INFO(info.get(), &output) != length) {
+        OPENSSL_cleanse(result.mutableSpan().data(), result.size());
+        return Exception { ExceptionCode::OperationError };
+    }
+    return result;
+}
+
+String CryptoKeyOKP::generateJwkD() const
+{
+    return base64URLEncodeToString(m_data);
+}
+
+String CryptoKeyOKP::generateJwkX() const
+{
+    if (type() == CryptoKeyType::Public)
+        return base64URLEncodeToString(m_data);
+    EvpPKeyPtr key(EVP_PKEY_new_raw_private_key(typeForCurve(namedCurve()), nullptr, m_data.span().data(), m_data.size()));
+    if (!key)
+        return { };
+    auto material = publicMaterial(key.get());
+    return material ? base64URLEncodeToString(*material) : String { };
+}
+
+Vector<uint8_t> CryptoKeyOKP::platformExportRaw() const
+{
+    return m_data;
+}
+
+} // namespace WebCore
