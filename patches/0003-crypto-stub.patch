--- /dev/null
+++ b/Source/WebCore/crypto/stub/CryptoStub.cmake
@@ -0,0 +1,5 @@
+# Web Crypto without a backend (USE_CRYPTO_STUB): crypto.subtle registers no algorithm, so every operation
+# rejects with NotSupportedError. CryptoStub.cpp defines the platform members that WebCore references.
+list(APPEND WebCore_SOURCES
+    crypto/stub/CryptoStub.cpp
+)
