+// The platform key of CryptoKeyEC and CryptoKeyRSA in a build without a Web Crypto backend (USE_CRYPTO_STUB).
+// The build registers no algorithm, so no key is ever created.
+
+#pragma once
+
+#if USE(CRYPTO_STUB)
+
+#include <memory>
+
+namespace WebCore {
+
+struct PlatformKeyStub { };
+
+} // namespace WebCore
+
+#endif
