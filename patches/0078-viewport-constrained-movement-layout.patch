+void LocalFrameView::setViewportConstrainedObjectsNeedMovementLayout()
+{
+    if (!hasViewportConstrainedObjects())
+        return;
+
+    // Moving the layout viewport's origin moves fixed boxes without resizing them. An out-of-flow movement layout
+    // updates their position, and a composited fixed layer keeps its backing store instead of repainting all of it
+    // (RenderLayer::shouldRepaintAfterLayout). A box whose movement changes its size falls back to a full layout.
+    for (CheckedRef renderer : *m_viewportConstrainedObjects) {
+        if (renderer->isOutOfFlowPositioned())
+            renderer->setNeedsOutOfFlowMovementLayout(nullptr);
+        else
+            renderer->setNeedsLayout();
+        if (renderer->hasLayer()) {
+            auto* layer = downcast<RenderBoxModelObject>(renderer).layer();
+            layer->setNeedsCompositingGeometryUpdate();
+        }
+    }
+}
