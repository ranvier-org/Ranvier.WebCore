 namespace WebCore {
 
+static bool prefersIncreasedContrastForRenderer([[maybe_unused]] const RenderObject& renderer)
+{
+#if PLATFORM(MAC)
+    switch (renderer.settings().forcedPrefersContrastAccessibilityValue()) {
+    case ForcedAccessibilityValue::On:
+        return true;
+    case ForcedAccessibilityValue::Off:
+        return false;
+    case ForcedAccessibilityValue::System:
+        break;
+    }
+#endif
+    return Theme::singleton().userPreferredContrast() == InterfaceContrastPreference::MoreContrast;
+}
