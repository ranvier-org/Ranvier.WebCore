diff --git a/Source/WebCore/dom/EventLoop.cpp b/Source/WebCore/dom/EventLoop.cpp
index 3abc026..3e32615 100644
--- a/Source/WebCore/dom/EventLoop.cpp
+++ b/Source/WebCore/dom/EventLoop.cpp
@@ -570,6 +570,15 @@ void EventLoopTaskGroup::queueMicrotask(JSC::VM& vm, EventLoop::TaskFunction&& f
         queueTask(TaskSource::InternalAsyncTask, WTF::move(function));
         return;
     }
+    // An embedder that disallows VM entry never drains the JavaScript microtask queue. A C++ microtask then runs as a
+    // checkpoint task, which every microtask checkpoint performs, in queueing order, without entering the VM.
+    if (vm.disallowVMEntryCount) [[unlikely]] {
+        if (m_state == State::Stopped || !m_eventLoop)
+            return;
+        runAtEndOfMicrotaskCheckpoint(WTF::move(function));
+        protect(m_eventLoop)->scheduleToRunIfNeeded();
+        return;
+    }
     JSC::JSLockHolder locker(vm);
     auto* cell = JSC::JSMicrotaskDispatcher::create(vm, EventLoopFunctionMicrotaskDispatcher::create(*this, WTF::move(function)));
     queueMicrotask(JSC::QueuedTask { cell });
