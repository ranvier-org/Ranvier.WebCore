+static bool setJWKPointCoordinates(const EC_GROUP* group, EC_POINT* point, const Vector<uint8_t>& xBytes, const Vector<uint8_t>& yBytes)
+{
+    if (!group || !point)
+        return false;
+    auto x = convertToBigNumber(xBytes);
+    auto y = convertToBigNumber(yBytes);
+    auto prime = BIGNUMPtr(BN_new());
+    if (!x || !y || !prime)
+        return false;
+    if (EC_GROUP_get_curve_GFp(group, prime.get(), nullptr, nullptr, nullptr) <= 0)
+        return false;
+    if (BN_cmp(x.get(), prime.get()) >= 0 || BN_cmp(y.get(), prime.get()) >= 0)
+        return false;
+    return EC_POINT_set_affine_coordinates_GFp(group, point, x.get(), y.get(), nullptr) > 0;
+}
