+struct ImeEndSerial {
+    uint64_t value { 0 };
+    WTF::Thread* owner;
+};
+
+static HashMap<const Editor*, ImeEndSerial>& compositionEndSerials()
+{
+    static NeverDestroyed<HashMap<const Editor*, ImeEndSerial>> serials;
+    return serials;
+}
+
+static void noteCompositionEnd(const Editor& editor)
+{
+    auto& serials = compositionEndSerials();
+    auto found = serials.find(&editor);
+    if (found != serials.end()) {
+        ASSERT(found->value.owner == &WTF::Thread::currentSingleton());
+        ++found->value.value;
+    }
+}
+
+Editor::~Editor()
+{
+    auto& serials = compositionEndSerials();
+    auto found = serials.find(this);
+    if (found != serials.end()) {
+        ASSERT(found->value.owner == &WTF::Thread::currentSingleton());
+        serials.remove(found);
+    }
+}
 
