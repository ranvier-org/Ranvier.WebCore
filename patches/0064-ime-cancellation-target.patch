+bool Editor::deleteSurroundingComposition(ContainerNode& editable, CharacterRange deletion, const String& originalText,
+    const VisibleSelection& compositionSelection, const Function<bool()>& validContext, const Function<void(SurroundingCompositionState)>& stateChanged)
+{
+    Ref document = this->document();
+    RefPtr oldCommand = m_lastEditCommand;
+    auto range = compositionRange();
+    if (!range || !oldCommand || !oldCommand->isTypingCommand() || !oldCommand->composition()
+        || deletion.location > originalText.length() || deletion.length > originalText.length() - deletion.location)
+        return false;
+    Ref oldComposition = *oldCommand->composition();
+    RefPtr originalNode = m_compositionNode;
+    auto serial = compositionEndSerial();
+    auto preedit = plainText(*range);
+    auto base = makeBoundaryPoint(compositionSelection.base());
+    auto extent = makeBoundaryPoint(compositionSelection.extent());
+    if (!base || !extent || base->container.ptr() != originalNode.get() || extent->container.ptr() != originalNode.get()
+        || base->offset < m_compositionStart || base->offset > m_compositionEnd
+        || extent->offset < m_compositionStart || extent->offset > m_compositionEnd)
+        return false;
+    auto baseOffset = base->offset - m_compositionStart;
+    auto extentOffset = extent->offset - m_compositionStart;
+    auto underlines = m_customCompositionUnderlines;
+    for (auto& underline : underlines) {
+        underline.startOffset -= m_compositionStart;
+        underline.endOffset -= m_compositionStart;
+    }
+    auto highlights = m_customCompositionHighlights;
+    for (auto& highlight : highlights) {
+        highlight.startOffset -= m_compositionStart;
+        highlight.endOffset -= m_compositionStart;
+    }
+    auto annotations = m_customCompositionAnnotations;
+    for (auto& entry : annotations) {
+        for (auto& annotation : entry.value)
+            annotation.location -= m_compositionStart;
+    }
+
+    auto currentText = plainText(makeRangeSelectingNodeContents(editable));
+    auto originalNodeData = originalNode->data();
+    RefPtr editableElement = dynamicDowncast<Element>(editable);
+    auto currentMarkup = editableElement ? editableElement->innerHTML() : String { };
+    Ref admission = DeleteSelectionCommand::create(document.copyRef());
+    admission->ensureComposition();
+    if (!willApplyEditing(admission, admission->targetRangesForBindings()) || !validContext()
+        || m_compositionNode != originalNode || compositionEndSerial() != serial || compositionRange() != range
+        || m_lastEditCommand != oldCommand || !originalNode->isConnected()
+        || plainText(makeRangeSelectingNodeContents(editable)) != currentText)
+        return false;
+
+    RefPtr target = document->focusedElement();
+    if (!target)
+        return false;
+    bool resumed = false;
+    bool unapplied = false;
+    stateChanged(SurroundingCompositionState::Suspending);
+    auto finishSuspension = makeScopeExit([&] {
+        if (resumed)
+            return;
+        TypingCommand::closeTyping(document);
+        m_lastEditCommand = nullptr;
+        bool unchanged = !unapplied && originalNode->isConnected() && originalNode->data() == originalNodeData
+            && editableElement && editableElement->innerHTML() == currentMarkup;
+        stateChanged(unchanged ? SurroundingCompositionState::AbortedUnchanged : SurroundingCompositionState::AbortedChanged);
+        if (compositionEndSerial() != serial || hasComposition()
+            || !target->isConnected() || &target->document() != document.ptr())
+            return;
+        notifyTextFromControls(oldComposition->startingRootEditableElement(), oldComposition->endingRootEditableElement());
+        m_customCompositionUnderlines.clear();
+        m_customCompositionHighlights.clear();
+        m_customCompositionAnnotations.clear();
+        if (CheckedPtr cache = document->existingAXObjectCache(); cache && originalNode->isConnected())
+            cache->onTextCompositionChange(*originalNode, CompositionState::Ended, false, emptyString(), m_compositionStart, m_isHandlingAcceptedCandidate);
+        cancelCompositionForTarget(*target, serial);
+    });
+    TypingCommand::closeTyping(document);
+    m_compositionNode = nullptr;
+    m_lastEditCommand = nullptr;
+    if (!oldComposition->unapplyForCompositionSuspension(validContext))
+        return false;
+    if (!validContext() || compositionEndSerial() != serial || hasComposition())
+        return false;
+    notifyTextFromControls(oldComposition->startingRootEditableElement(), oldComposition->endingRootEditableElement());
+    if (plainText(makeRangeSelectingNodeContents(editable)) != originalText)
+        return false;
+    unapplied = true;
+    stateChanged(SurroundingCompositionState::Unapplied);
+    auto selectedOriginal = oldComposition->startingSelection();
+    auto selectedRange = selectedOriginal.firstRange();
+    if (!selectedRange)
+        return false;
+    Ref trackedSelection = Range::create(document);
+    if (trackedSelection->setStart(selectedRange->start.container.copyRef(), selectedRange->start.offset).hasException()
+        || trackedSelection->setEnd(selectedRange->end.container.copyRef(), selectedRange->end.offset).hasException())
+        return false;
+
+    auto deletionRange = resolveCharacterRange(makeRangeSelectingNodeContents(editable), deletion);
+    document->selection().setSelection(VisibleSelection { deletionRange });
+    Ref acceptedDeletion = AcceptedSurroundingDeleteCommand::create(document);
+    acceptedDeletion->apply();
+    if (!validContext() || compositionEndSerial() != serial || hasComposition())
+        return false;
+    auto expected = makeString(originalText.substring(0, deletion.location), originalText.substring(deletion.location + deletion.length));
+    if (plainText(makeRangeSelectingNodeContents(editable)) != expected)
+        return false;
+
+    auto originalRange = makeSimpleRange(trackedSelection);
+    auto& anchor = selectedOriginal.isBaseFirst() ? originalRange.start : originalRange.end;
+    auto& focus = selectedOriginal.isBaseFirst() ? originalRange.end : originalRange.start;
+    document->selection().setSelection(VisibleSelection {
+        VisiblePosition { makeContainerOffsetPosition(anchor), selectedOriginal.affinity() },
+        VisiblePosition { makeContainerOffsetPosition(focus), selectedOriginal.affinity() }, selectedOriginal.directionality() });
+    TypingCommand::rebuildComposition(document, preedit);
+    if (!validContext() || compositionEndSerial() != serial || hasComposition())
+        return false;
+    auto inserted = document->selection().selection().firstRange();
+    if (!inserted || inserted->start.container.ptr() != inserted->end.container.ptr() || plainText(*inserted) != preedit)
+        return false;
+    RefPtr node = dynamicDowncast<Text>(inserted->start.container.get());
+    if (!node)
+        return false;
+    m_compositionNode = node;
+    m_compositionStart = inserted->start.offset;
+    m_compositionEnd = inserted->end.offset;
+    for (auto& underline : underlines) {
+        underline.startOffset += m_compositionStart;
+        underline.endOffset += m_compositionStart;
+    }
+    m_customCompositionUnderlines = WTF::move(underlines);
+    for (auto& highlight : highlights) {
+        highlight.startOffset += m_compositionStart;
+        highlight.endOffset += m_compositionStart;
+    }
+    m_customCompositionHighlights = WTF::move(highlights);
+    for (auto& entry : annotations) {
+        for (auto& annotation : entry.value)
+            annotation.location += m_compositionStart;
+    }
+    m_customCompositionAnnotations = WTF::move(annotations);
+    document->selection().setSelection(VisibleSelection {
+        VisiblePosition { makeContainerOffsetPosition({ *node, m_compositionStart + baseOffset }), compositionSelection.affinity() },
+        VisiblePosition { makeContainerOffsetPosition({ *node, m_compositionStart + extentOffset }), compositionSelection.affinity() }, compositionSelection.directionality() }, { });
+    if (CheckedPtr renderer = node->renderer())
+        renderer->repaint();
+    if (CheckedPtr cache = document->existingAXObjectCache())
+        cache->onTextCompositionChange(*node, CompositionState::InProgress, true, preedit, m_compositionStart, m_isHandlingAcceptedCandidate);
+    resumed = true;
+    stateChanged(SurroundingCompositionState::Rebuilt);
+    if (!validContext())
+        return true;
+    dispatchInputEvents(acceptedDeletion->composition()->startingRootEditableElement(), acceptedDeletion->composition()->endingRootEditableElement(),
+        acceptedDeletion->inputEventTypeName(), IsInputMethodComposing::No, acceptedDeletion->inputEventData(), acceptedDeletion->inputEventDataTransfer());
+    return true;
+}
