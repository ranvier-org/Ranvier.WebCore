+
+bool Editor::relocateCompositionAfterDeletion(const SimpleRange& range, Text& originalNode, uint64_t expectedEndSerial, const String& expectedText)
+{
+    if (compositionEndSerial() != expectedEndSerial || m_compositionNode.get() != &originalNode)
+        return false;
+    RefPtr text = dynamicDowncast<Text>(range.start.container.get());
+    if (!text || range.end.container.ptr() != text.get() || !text->isConnected()
+        || range.end.offset < range.start.offset || range.end.offset > text->length()
+        || text->data().substring(range.start.offset, range.end.offset - range.start.offset) != expectedText)
+        return false;
+    m_compositionNode = text;
+    m_compositionStart = range.start.offset;
+    m_compositionEnd = range.end.offset;
+    return true;
+}
+
+void Editor::cancelCompositionForTarget(Element& target, uint64_t expectedEndSerial)
+{
+    if (compositionEndSerial() != expectedEndSerial)
+        return;
+    if (m_compositionNode) {
+        cancelCompositionWithTarget(&target);
+        return;
+    }
+    Ref document = this->document();
+    noteCompositionEnd(*this);
+    target.dispatchEvent(CompositionEvent::create(eventNames().compositionendEvent, document->windowProxy(), emptyString()));
+}
