@@ -0,0 +1,69 @@
+// Members of WebCore's File System, entries API and WebGPU types for a build without them
+// (USE_BROWSER_API_STUB).
+//
+// No File System handle, storage connection, entry or GPU object is ever created: page scripts have no
+// interface that returns one, and the context lookups below report no storage connection, so
+// deserializing a handle fails. Every other member is a release assertion.
+
+#include "config.h"
+
+#include "DOMFileSystem.h"
+#include "File.h"
+#include "FileSystemDirectoryHandle.h"
+#include "FileSystemFileHandle.h"
+#include "FileSystemHandleStorageKeepAlive.h"
+#include "FileSystemStorageConnection.h"
+#include "GPU.h"
+#include "GPUCanvasContext.h"
+#include "WGSLLanguageFeatures.h"
+#include "WorkerFileSystemStorageConnection.h"
+#include <wtf/RefPtr.h>
+
+namespace WebCore {
+
+RefPtr<FileSystemStorageConnection> fileSystemStorageConnectionForContext(ScriptExecutionContext&)
+{
+    return nullptr;
+}
+
+ClientOrigin clientOriginForContext(ScriptExecutionContext&) { RELEASE_ASSERT_NOT_REACHED(); }
+
+FileSystemHandleKeepAlive::FileSystemHandleKeepAlive(ClientOrigin&&, FileSystemHandleGlobalIdentifier, Ref<FileSystemStorageConnection>&&) { RELEASE_ASSERT_NOT_REACHED(); }
+
+// A keep-alive is only ever default-constructed or moved from, so it holds no connection.
+FileSystemHandleKeepAlive::~FileSystemHandleKeepAlive() { RELEASE_ASSERT(!m_connection); }
+
+FileSystemHandleKeepAlive FileSystemHandleKeepAlive::copy() const { RELEASE_ASSERT_NOT_REACHED(); }
+
+FileSystemHandleStorageKeepAlive::~FileSystemHandleStorageKeepAlive() { RELEASE_ASSERT_NOT_REACHED(); }
+
+void FileSystemHandle::markAsUnresolved(ClientOrigin&&, Ref<FileSystemStorageConnection>&&) { RELEASE_ASSERT_NOT_REACHED(); }
+
+Ref<FileSystemFileHandle> FileSystemFileHandle::create(ScriptExecutionContext&, String&&, FileSystemHandleGlobalIdentifier) { RELEASE_ASSERT_NOT_REACHED(); }
+
+Ref<FileSystemDirectoryHandle> FileSystemDirectoryHandle::create(ScriptExecutionContext&, String&&, FileSystemHandleGlobalIdentifier) { RELEASE_ASSERT_NOT_REACHED(); }
+
+Ref<FileSystemDirectoryHandle> FileSystemDirectoryHandle::create(ScriptExecutionContext&, String&&, FileSystemHandleGlobalIdentifier, FileSystemHandleIdentifier, Ref<FileSystemStorageConnection>&&) { RELEASE_ASSERT_NOT_REACHED(); }
+
+Ref<WorkerFileSystemStorageConnection> WorkerFileSystemStorageConnection::create(WorkerGlobalScope&, Ref<FileSystemStorageConnection>&&) { RELEASE_ASSERT_NOT_REACHED(); }
+
+void WorkerFileSystemStorageConnection::scopeClosed() { RELEASE_ASSERT_NOT_REACHED(); }
+
+void WorkerFileSystemStorageConnection::connectionClosed() { RELEASE_ASSERT_NOT_REACHED(); }
+
+DOMFileSystem::~DOMFileSystem() { RELEASE_ASSERT_NOT_REACHED(); }
+
+Ref<FileSystemEntry> DOMFileSystem::fileAsEntry(ScriptExecutionContext&) { RELEASE_ASSERT_NOT_REACHED(); }
+
+GPU::~GPU() { RELEASE_ASSERT_NOT_REACHED(); }
+
+std::unique_ptr<GPUCanvasContext> GPUCanvasContext::create(CanvasBase&, GPU&, Document*) { RELEASE_ASSERT_NOT_REACHED(); }
+
+} // namespace WebCore
+
+// The DOMFileSystem constructor resolves to browserAPIStubNotReached.
+extern "C" void browserAPIStubNotReached()
+{
+    RELEASE_ASSERT_NOT_REACHED();
+}
+#pragma comment(linker, "/alternatename:??0DOMFileSystem@WebCore@@AEAA@$$QEAV?$Ref@VFile@WebCore@@U?$RawPtrTraits@VFile@WebCore@@@WTF@@U?$DefaultRefDerefTraits@VFile@WebCore@@@4@@WTF@@@Z=browserAPIStubNotReached")
