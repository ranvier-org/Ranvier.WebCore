diff --git a/Source/WebCore/Modules/stub/BrowserAPIStub.cmake b/Source/WebCore/Modules/stub/BrowserAPIStub.cmake
new file mode 100644
index 0000000..3d73fbb
--- /dev/null
+++ b/Source/WebCore/Modules/stub/BrowserAPIStub.cmake
@@ -0,0 +1,60 @@
+# WebCore without WebTransport, the File System and entries APIs, WebXR and the WebGPU bindings
+# (USE_BROWSER_API_STUB). Their sources and IDL files are left out. The IDL files in Modules/stub/idl
+# replace the interfaces and mixins referenced by the remaining WebCore code; they declare no members
+# and no interface objects. BrowserAPIStub.cpp defines the members of the excluded types that the
+# remaining WebCore code references.
+
+set(WebCore_BROWSER_API_STUB_EXCLUDED "^Modules/(WebGPU|entriesapi|filesystem|webtransport|webxr)/|^html/canvas/GPU(BasedCanvasRenderingContext|CanvasContext)\.")
+set(WebCore_BROWSER_API_STUB_IDL_FILES
+    Modules/stub/idl/FileSystemDirectoryHandle.idl
+    Modules/stub/idl/FileSystemEntry.idl
+    Modules/stub/idl/FileSystemFileHandle.idl
+    Modules/stub/idl/FileSystemHandle.idl
+    Modules/stub/idl/GPUCanvasContext.idl
+)
+
+list(APPEND WebCore_UNIFIED_SOURCE_EXCLUDES
+    "${WebCore_BROWSER_API_STUB_EXCLUDED}"
+    "^bindings/js/JSWebXR(RigidTransform|Session|View)Custom\.cpp"
+)
+
+set(WebCore_BROWSER_API_STUB_EXCLUDED_IDL_FILES ${WebCore_IDL_FILES} ${WebCore_SUPPLEMENTAL_IDL_FILES})
+list(FILTER WebCore_BROWSER_API_STUB_EXCLUDED_IDL_FILES INCLUDE REGEX "${WebCore_BROWSER_API_STUB_EXCLUDED}")
+foreach (_idl IN LISTS WebCore_BROWSER_API_STUB_EXCLUDED_IDL_FILES)
+    get_filename_component(_name "${_idl}" NAME_WE)
+    if (NOT "${WebCore_BROWSER_API_STUB_IDL_FILES}" MATCHES "/${_name}\.idl")
+        list(APPEND WebCore_UNIFIED_SOURCE_EXCLUDES "^JS${_name}\.cpp")
+    endif ()
+endforeach ()
+
+list(FILTER WebCore_IDL_FILES EXCLUDE REGEX "${WebCore_BROWSER_API_STUB_EXCLUDED}")
+list(FILTER WebCore_SUPPLEMENTAL_IDL_FILES EXCLUDE REGEX "${WebCore_BROWSER_API_STUB_EXCLUDED}")
+list(APPEND WebCore_IDL_FILES ${WebCore_BROWSER_API_STUB_IDL_FILES})
+list(APPEND WebCore_SUPPLEMENTAL_IDL_FILES
+    Modules/stub/idl/NavigatorGPU.idl
+)
+
+# The event factory inputs without the excluded events and event targets, read from the inputs
+# already in use.
+function(BROWSER_API_STUB_FACTORY _input _name _variable _excluded)
+    file(READ "${_input}" _contents)
+    string(REPLACE "\n" ";" _lines "${_contents}")
+    list(FILTER _lines EXCLUDE REGEX "^(${_excluded})( .*)?$")
+    string(REPLACE ";" "\n" _contents "${_lines}")
+    file(WRITE "${WebCore_DERIVED_SOURCES_DIR}/BrowserAPIStub${_name}.in" "${_contents}")
+    set(${_variable} "${WebCore_DERIVED_SOURCES_DIR}/BrowserAPIStub${_name}.in" PARENT_SCOPE)
+endfunction()
+if (NOT WebCore_EVENT_INTERFACES_FILE)
+    set(WebCore_EVENT_INTERFACES_FILE "${WEBCORE_DIR}/dom/EventInterfaces.in")
+endif ()
+if (NOT WebCore_EVENT_TARGET_FACTORY_FILE)
+    set(WebCore_EVENT_TARGET_FACTORY_FILE "${WEBCORE_DIR}/dom/EventTargetFactory.in")
+endif ()
+BROWSER_API_STUB_FACTORY("${WebCore_EVENT_INTERFACES_FILE}" EventInterfaces WebCore_EVENT_INTERFACES_FILE
+    "GPUUncapturedErrorEvent|XR[A-Za-z]*Event")
+BROWSER_API_STUB_FACTORY("${WebCore_EVENT_TARGET_FACTORY_FILE}" EventTargetFactory WebCore_EVENT_TARGET_FACTORY_FILE
+    "GPUDevice|WebXR[A-Za-z]*")
+
+list(APPEND WebCore_SOURCES
+    Modules/stub/BrowserAPIStub.cpp
+)
diff --git a/Source/WebCore/Modules/stub/BrowserAPIStub.cpp b/Source/WebCore/Modules/stub/BrowserAPIStub.cpp
