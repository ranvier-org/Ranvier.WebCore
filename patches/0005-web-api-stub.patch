diff --git a/Source/WebCore/Modules/stub/WebAPIStub.cmake b/Source/WebCore/Modules/stub/WebAPIStub.cmake
new file mode 100644
index 0000000..fc1a530
--- /dev/null
+++ b/Source/WebCore/Modules/stub/WebAPIStub.cmake
@@ -0,0 +1,72 @@
+# WebCore without IndexedDB, service and shared workers, WebSockets, the Cache API, the Cookie Store
+# API, the Push API and Background Fetch (USE_WEB_API_STUB). Their sources and IDL files are left out.
+# The IDL files in Modules/stub/idl replace the interfaces and mixins referenced by the remaining
+# WebCore code; they declare no members and no interface objects. WebAPIStub.cpp defines the members
+# of the excluded types that the remaining WebCore code references.
+
+set(WebCore_WEB_API_STUB_EXCLUDED "^Modules/(cache|cookie-store|indexeddb|push-api|websockets)/|^workers/(service|shared)/")
+set(WebCore_WEB_API_STUB_IDL_FILES
+    Modules/stub/idl/ExtendableEvent.idl
+    Modules/stub/idl/ExtendableMessageEvent.idl
+    Modules/stub/idl/IDBFactory.idl
+    Modules/stub/idl/PushEvent.idl
+    Modules/stub/idl/PushSubscription.idl
+    Modules/stub/idl/ServiceWorker.idl
+    Modules/stub/idl/ServiceWorkerGlobalScope.idl
+    Modules/stub/idl/SharedWorkerGlobalScope.idl
+    Modules/stub/idl/WebSocket.idl
+)
+
+list(APPEND WebCore_UNIFIED_SOURCE_EXCLUDES
+    "${WebCore_WEB_API_STUB_EXCLUDED}"
+    "^bindings/js/(IDBBindingUtilities|JSExtendableMessageEventCustom|JSFetchEventCustom|JSIDBCursorCustom|JSIDBCursorWithValueCustom|JSIDBObjectStoreCustom|JSIDBRecordCustom|JSIDBRequestCustom|JSIDBTransactionCustom|JSServiceWorkerGlobalScopeCustom)\.cpp"
+)
+
+set(WebCore_WEB_API_STUB_EXCLUDED_IDL_FILES ${WebCore_IDL_FILES})
+list(FILTER WebCore_WEB_API_STUB_EXCLUDED_IDL_FILES INCLUDE REGEX "${WebCore_WEB_API_STUB_EXCLUDED}|^Modules/notifications/NotificationEvent\.idl$")
+foreach (_idl IN LISTS WebCore_WEB_API_STUB_EXCLUDED_IDL_FILES)
+    get_filename_component(_name "${_idl}" NAME_WE)
+    if (NOT "${WebCore_WEB_API_STUB_IDL_FILES}" MATCHES "/${_name}\.idl")
+        list(APPEND WebCore_UNIFIED_SOURCE_EXCLUDES "^JS${_name}\.cpp")
+    endif ()
+endforeach ()
+
+list(FILTER WebCore_IDL_FILES EXCLUDE REGEX "${WebCore_WEB_API_STUB_EXCLUDED}|^Modules/notifications/NotificationEvent\.idl$")
+list(FILTER WebCore_SUPPLEMENTAL_IDL_FILES EXCLUDE REGEX "${WebCore_WEB_API_STUB_EXCLUDED}|^page/NavigatorServiceWorker\.idl$")
+list(APPEND WebCore_IDL_FILES ${WebCore_WEB_API_STUB_IDL_FILES})
+list(APPEND WebCore_SUPPLEMENTAL_IDL_FILES
+    Modules/stub/idl/NavigatorServiceWorker.idl
+    Modules/stub/idl/WindowPush.idl
+)
+
+# The event factory input without the excluded events. ExtendableEvent, ExtendableMessageEvent and
+# PushEvent stay: headers included by the remaining code reference their event interface types.
+function(WEB_API_STUB_FACTORY _name _variable _excluded)
+    file(READ "${WEBCORE_DIR}/dom/${_name}.in" _contents)
+    string(REPLACE "\n" ";" _lines "${_contents}")
+    list(FILTER _lines EXCLUDE REGEX "^(${_excluded})( .*)?$")
+    string(REPLACE ";" "\n" _contents "${_lines}")
+    set(_output "${WebCore_DERIVED_SOURCES_DIR}/${_name}.in")
+    # Written only when it changes: the file's time is an input of the event factory rules.
+    if (EXISTS "${_output}")
+        file(READ "${_output}" _written)
+    endif ()
+    if (NOT EXISTS "${_output}" OR NOT _written STREQUAL _contents)
+        file(WRITE "${_output}" "${_contents}")
+    endif ()
+    set(${_variable} "${_output}" PARENT_SCOPE)
+endfunction()
+WEB_API_STUB_FACTORY(EventInterfaces WebCore_EVENT_INTERFACES_FILE
+    "BackgroundFetchEvent|BackgroundFetchUpdateUIEvent|CloseEvent|CookieChangeEvent|ExtendableCookieChangeEvent|FetchEvent|IDBVersionChangeEvent|InstallEvent|NotificationEvent|PushSubscriptionChangeEvent")
+
+# The event target factory includes JS<Name>.h for every event target type. These headers declare the
+# toJS overloads of the excluded event target types, which WebAPIStub.cpp defines.
+foreach (WEB_API_STUB_EVENT_TARGET IN ITEMS BackgroundFetchRegistration CookieStore IDBDatabase IDBOpenDBRequest IDBRequest
+                                          IDBTransaction ServiceWorkerContainer ServiceWorkerRegistration SharedWorker)
+    configure_file(${WEBCORE_DIR}/Modules/stub/JSEventTargetStub.h.in
+        ${WebCore_DERIVED_SOURCES_DIR}/JS${WEB_API_STUB_EVENT_TARGET}.h @ONLY)
+endforeach ()
+
+list(APPEND WebCore_SOURCES
+    Modules/stub/WebAPIStub.cpp
+)
