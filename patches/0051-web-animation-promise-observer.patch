+
+#pragma once
+
+#include "ExceptionCode.h"
+#include <optional>
+
+namespace WebCore {
+
+class WebAnimation;
+
+enum class WebAnimationPromiseKind : uint8_t { Ready, Finished };
+
+// Called on the main thread each time an animation's ready or finished promise settles: with std::nullopt when it
+// resolves, and with the exception code when the engine rejects it; a rejection is reported when the engine schedules
+// it. promise identifies the settled promise object; it is compared, never dereferenced.
+using WebAnimationPromiseObserver = void (*)(WebAnimation&, WebAnimationPromiseKind, const void* promise, std::optional<ExceptionCode>);
+
+// Installs the process-wide observer, or with nullptr removes it.
+WEBCORE_EXPORT void setWebAnimationPromiseObserver(WebAnimationPromiseObserver);
+
+} // namespace WebCore
