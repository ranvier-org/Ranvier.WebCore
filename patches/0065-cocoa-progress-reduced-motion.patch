+bool RenderTheme::prefersReducedMotionForRenderer(const RenderElement& renderer)
+{
+    switch (renderer.settings().forcedPrefersReducedMotionAccessibilityValue()) {
+    case ForcedAccessibilityValue::On:
+        return true;
+    case ForcedAccessibilityValue::Off:
+        return false;
+    case ForcedAccessibilityValue::System:
+        return Theme::singleton().userPrefersReducedMotion();
+    }
+    return false;
+}
