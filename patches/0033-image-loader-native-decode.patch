-void ImageLoader::decode(Ref<DeferredPromise>&& promise)
+bool ImageLoader::registerDecodeRequest()
 {
-    m_decodingPromises.append(WTF::move(promise));
-
     if (!element().document().window()) {
-        rejectDecodePromises("Inactive document."_s);
-        return;
+        rejectDecodePromises("Inactive document."_s, ImageDecodeResult::InactiveDocument);
+        return false;
     }
 
     auto attr = protect(element())->imageSourceURL();
     if (StringView(attr).containsOnly<isASCIIWhitespace<char16_t>>()) {
-        rejectDecodePromises("Missing source URL."_s);
-        return;
+        rejectDecodePromises("Missing source URL."_s, ImageDecodeResult::MissingSource);
+        return false;
     }
+    return true;
+}
+
+void ImageLoader::decode(Function<void(ImageDecodeResult)>&& waiter)
+{
+    m_decodeWaiters.append(WTF::move(waiter));
+    if (!registerDecodeRequest() || !m_imageComplete)
+        return;
+    Ref document = element().document();
+    document->eventLoop().queueTask(TaskSource::InternalAsyncTask, [weakThis = WeakPtr { *this }] {
+        RefPtr protectedThis = weakThis;
+        if (!protectedThis || !protectedThis->m_imageComplete)
+            return;
+        protectedThis->decode();
+    });
+}
+
+void ImageLoader::decode(Ref<DeferredPromise>&& promise)
+{
+    m_decodingPromises.append(WTF::move(promise));
+    if (!registerDecodeRequest())
+        return;
 
     if (m_imageComplete) {
         Ref document = element().document();
@@ -630,13 +659,13 @@
         return;
     
     if (!element().document().window()) {
-        rejectDecodePromises("Inactive document."_s);
+        rejectDecodePromises("Inactive document."_s, ImageDecodeResult::InactiveDocument);
         return;
     }
 
     RefPtr image = m_image;
     if (!image || !image->image() || image->errorOccurred()) {
-        rejectDecodePromises("Loading error."_s);
+        rejectDecodePromises("Loading error."_s, ImageDecodeResult::LoadError);
         return;
     }
 
@@ -646,12 +675,15 @@
         return;
     }
 
-    bitmapImage->decode([promises = WTF::move(m_decodingPromises)](DecodingStatus decodingStatus) mutable {
+    bitmapImage->decode([promises = WTF::move(m_decodingPromises), waiters = WTF::move(m_decodeWaiters)](DecodingStatus decodingStatus) mutable {
         ASSERT(decodingStatus != DecodingStatus::Decoding);
-        if (decodingStatus == DecodingStatus::Invalid)
+        if (decodingStatus == DecodingStatus::Invalid) {
             rejectPromises(promises, "Decoding error."_s);
-        else
+            settleWaiters(waiters, ImageDecodeResult::DecodeError);
+        } else {
             resolvePromises(promises);
+            settleWaiters(waiters, ImageDecodeResult::Decoded);
+        }
     });
 }
 
