diff --git a/Source/bmalloc/libpas/src/libpas/pas_config.h b/Source/bmalloc/libpas/src/libpas/pas_config.h
index 405c142..4c45d19 100644
--- a/Source/bmalloc/libpas/src/libpas/pas_config.h
+++ b/Source/bmalloc/libpas/src/libpas/pas_config.h
@@ -120,6 +120,19 @@
 #endif
 #endif /* PAS_USE_SYMMETRIC_PAGE_ALLOCATION */
 
+/* PAS_WINDOWS_LAZY_COMMIT makes the three large mappings libpas creates up front reserve address space
+ * only: the compact heap reservation, each megapage and each large expendable memory. Their owners commit
+ * what they hand out. Windows charges commit for a page when it is committed, not when it is touched, so
+ * without this a process pays for 128 MB, 32 MB per megapage and 64 MB that it mostly never uses.
+ *
+ * It needs the symmetric scheme: a page that was only reserved faults until it is committed. */
+#ifndef PAS_WINDOWS_LAZY_COMMIT
+#define PAS_WINDOWS_LAZY_COMMIT 0
+#endif
+#if PAS_WINDOWS_LAZY_COMMIT && !(PAS_OS(WINDOWS) && PAS_USE_SYMMETRIC_PAGE_ALLOCATION)
+#error "PAS_WINDOWS_LAZY_COMMIT needs Windows and PAS_USE_SYMMETRIC_PAGE_ALLOCATION"
+#endif
+
 #define PAS_RISCV __PAS_RISCV
 
 #define PAS_ADDRESS_BITS                 48
diff --git a/Source/bmalloc/libpas/src/libpas/pas_expendable_memory.c b/Source/bmalloc/libpas/src/libpas/pas_expendable_memory.c
index 656ba5a..b0354d9 100644
--- a/Source/bmalloc/libpas/src/libpas/pas_expendable_memory.c
+++ b/Source/bmalloc/libpas/src/libpas/pas_expendable_memory.c
@@ -100,6 +100,18 @@ void* pas_expendable_memory_try_allocate(pas_expendable_memory* header,
     first = (aligned_bump - sizeof(pas_expendable_memory_state_version)) / PAS_EXPENDABLE_MEMORY_PAGE_SIZE;
     last = (aligned_bump + size - 1) / PAS_EXPENDABLE_MEMORY_PAGE_SIZE;
 
+#if PAS_WINDOWS_LAZY_COMMIT
+    /* The payload starts out reserved. Its pages are committed here, as the bump pointer first reaches
+       them, and stay committed: scavenging discards their contents without decommitting, so a reader
+       never meets a page that faults. Committing a page that an earlier allocation committed changes
+       nothing. */
+    pas_page_malloc_commit_without_mprotect(
+        (char*)payload + first * PAS_EXPENDABLE_MEMORY_PAGE_SIZE,
+        (last - first + 1) * PAS_EXPENDABLE_MEMORY_PAGE_SIZE,
+        /* is_symmetric */ true,
+        pas_page_flags_none);
+#endif
+
     version = PAS_MAX(pas_expendable_memory_state_get_version(header->states[first]),
                       pas_expendable_memory_state_get_version(header->states[last]));
 
