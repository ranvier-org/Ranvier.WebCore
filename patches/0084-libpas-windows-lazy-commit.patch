 #endif
 
+#if PAS_WINDOWS_LAZY_COMMIT
+size_t pas_compact_heap_reservation_reserve_only_size = 0;
+
+/* Every page of the reservation below this address is committed, or belongs to an allocation that was
+   left reserved for its owner to commit. */
+static uintptr_t compact_heap_reservation_commit_frontier = 0;
+#endif
+
