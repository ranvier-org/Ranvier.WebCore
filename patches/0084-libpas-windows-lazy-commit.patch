+    if (megapage_cache_commits_pages(cache))
+        pas_page_malloc_reserve_only_alignment = new_alignment.alignment;
+#endif
     bootstrap_result = cache->provider(
         new_size, new_alignment,
         "pas_megapage_cache/chunk",
         data->heap,
         data->transaction,
         cache->provider_arg);
+#if PAS_WINDOWS_LAZY_COMMIT
