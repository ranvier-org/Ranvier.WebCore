 pas_page_malloc_try_allocate_without_deallocating_padding(
     size_t size, pas_alignment alignment, bool may_contain_small_or_medium);
 
+#if PAS_WINDOWS_LAZY_COMMIT
+/* While this is nonzero, a mapping requested with this alignment is reserved and not committed, and is
+   returned without padding: the caller commits the parts of the result it hands out, and the address
+   space around the result stays reserved and unused. Zero at all other times. The owner sets it around
+   the one call that maps its memory, with the heap lock held, and passes an alignment no allocation
+   nested in that call asks for. */
+PAS_API extern size_t pas_page_malloc_reserve_only_alignment;
+#endif
