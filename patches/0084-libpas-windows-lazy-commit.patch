 {
     pas_aligned_allocation_result result;
@@ -70,8 +78,15 @@ pas_aligned_allocation_result pas_compact_heap_reservation_try_allocate(size_t s
         page_result.result = memory_extra_vss_reserve(pas_compact_heap_reservation_size, pas_page_malloc_alignment());
         PAS_ASSERT(page_result.result);
 #else
+#if PAS_WINDOWS_LAZY_COMMIT
+        pas_page_malloc_reserve_only_alignment = pas_alignment_create_trivial().alignment;
+#endif
         page_result = pas_page_malloc_try_allocate_without_deallocating_padding(
             pas_compact_heap_reservation_size, pas_alignment_create_trivial(), false);
+#if PAS_WINDOWS_LAZY_COMMIT
+        pas_page_malloc_reserve_only_alignment = 0;
+        compact_heap_reservation_commit_frontier = (uintptr_t)page_result.result;
+#endif
         PAS_ASSERT(!page_result.left_padding_size);
         PAS_ASSERT(!page_result.right_padding_size);
         PAS_ASSERT(page_result.result);
@@ -125,6 +140,34 @@ pas_aligned_allocation_result pas_compact_heap_reservation_try_allocate(size_t s
     }
 #endif
 
+#if PAS_WINDOWS_LAZY_COMMIT
+    /* Commit from the frontier, not from this allocation's first page: the padding before the allocation
+       is returned to the caller as usable memory too. An allocation left reserved is committed only up to
+       its first page, and the frontier then skips to its last page. */
+    {
+        size_t page_size;
+        bool leave_reserved;
+        uintptr_t commit_end;
+
+        page_size = pas_page_malloc_alignment();
+        leave_reserved = pas_compact_heap_reservation_reserve_only_size
+            && size == pas_compact_heap_reservation_reserve_only_size;
+        commit_end = pas_round_up_to_power_of_2(leave_reserved ? allocation_start : allocation_end, page_size);
+        if (commit_end > compact_heap_reservation_commit_frontier) {
+            pas_page_malloc_commit(
+                (void*)compact_heap_reservation_commit_frontier,
+                commit_end - compact_heap_reservation_commit_frontier,
+                pas_page_flags_none);
+            compact_heap_reservation_commit_frontier = commit_end;
+        }
+        if (leave_reserved) {
+            compact_heap_reservation_commit_frontier = PAS_MAX(
+                compact_heap_reservation_commit_frontier,
+                pas_round_down_to_power_of_2(allocation_end, page_size));
+        }
+    }
+#endif
+
     result.left_padding = (void*)padding_start;
     result.left_padding_size = allocation_start - padding_start;
     result.result = (void*)allocation_start;
