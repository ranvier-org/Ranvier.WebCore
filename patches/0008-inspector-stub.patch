diff --git a/Source/WebCore/inspector/stub/generate-inspector-stub.py b/Source/WebCore/inspector/stub/generate-inspector-stub.py
new file mode 100644
index 0000000..533d26a
--- /dev/null
+++ b/Source/WebCore/inspector/stub/generate-inspector-stub.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+#
+# Writes, for a build without the inspector (USE_INSPECTOR_STUB), definitions of the inspector members
+# that the remaining WebCore code calls through templates and inline functions, read from their
+# declarations:
+#
+# - InspectorInstrumentation's private *Impl hooks, from InspectorInstrumentation.h. Each does nothing
+#   and returns a value-initialized result, which is what the hooks do while no frontend is connected.
+# - The canvas call tracer's argument processors, from InspectorCanvasArguments.h. Each is a release
+#   assertion: the generated bindings process arguments only while a canvas recording is active.
+#
+# Usage: generate-inspector-stub.py InspectorInstrumentation.h InspectorCanvasArguments.h output.cpp
+
+import re
+import sys
+
+instrumentation_path, canvas_arguments_path, output_path = sys.argv[1:]
+
+preprocessor = re.compile(r'^\s*#\s*(if|ifdef|ifndef|elif|else|endif)\b')
+
+
+def read_lines(path):
+    with open(path, encoding='utf-8') as file:
+        return file.read().splitlines()
+
+
+def instrumentation_hooks(lines):
+    class_start = lines.index('class InspectorInstrumentation {')
+    private_start = lines.index('private:', class_start)
+    class_end = lines.index('};', private_start)
+    hook = re.compile(r'^\s*static (\w+) (\w+Impl)\((.*)\);$')
+    default_argument = re.compile(r'\s*=\s*(\{\s*\}|[^,]+)')
+    definitions, count = [], 0
+    for line in lines[private_start + 1:class_end]:
+        if preprocessor.match(line):
+            definitions.append(line.strip())
+            continue
+        match = hook.match(line)
+        if not match:
+            continue
+        result, name, parameters = match.groups()
+        body = '' if result == 'void' else ' return { }; '
+        definitions.append('%s InspectorInstrumentation::%s(%s) {%s}' % (result, name, default_argument.sub('', parameters), body))
+        count += 1
+    return definitions, count
+
+
+def canvas_argument_processors(lines):
+    specialization = re.compile(r'^template<> struct InspectorCanvasArgumentProcessor<(.*)> \{$')
+    operator = re.compile(r'^\s*std::optional<InspectorCanvasProcessedArgument> (?:NODELETE )?operator\(\)\((.*)\);$')
+    definitions, count, processor = [], 0, None
+    for line in lines:
+        if preprocessor.match(line):
+            definitions.append(line.strip())
+            continue
+        match = specialization.match(line)
+        if match:
+            processor = match.group(1)
+            continue
+        match = operator.match(line)
+        if match and processor:
+            definitions.append('std::optional<InspectorCanvasProcessedArgument> InspectorCanvasArgumentProcessor<%s>::operator()(%s) { RELEASE_ASSERT_NOT_REACHED(); }' % (processor, match.group(1)))
+            count += 1
+        processor = None
+    return definitions, count
+
+
+hooks, hook_count = instrumentation_hooks(read_lines(instrumentation_path))
+processors, processor_count = canvas_argument_processors(read_lines(canvas_arguments_path))
+if not hook_count or not processor_count:
+    sys.exit('Found %d *Impl hooks and %d canvas argument processors' % (hook_count, processor_count))
+
+with open(output_path, 'w', encoding='utf-8', newline='\n') as output:
+    output.write('// Generated by generate-inspector-stub.py from InspectorInstrumentation.h and InspectorCanvasArguments.h.\n\n')
+    output.write('#include "config.h"\n#include "InspectorCanvasArguments.h"\n#include "InspectorInstrumentation.h"\n\nnamespace WebCore {\n\n')
+    output.write('\n'.join(hooks + [''] + processors))
+    output.write('\n\n} // namespace WebCore\n')
