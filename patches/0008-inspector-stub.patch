diff --git a/Source/WebCore/inspector/stub/InspectorStub.cmake b/Source/WebCore/inspector/stub/InspectorStub.cmake
new file mode 100644
index 0000000..376a6ae
--- /dev/null
+++ b/Source/WebCore/inspector/stub/InspectorStub.cmake
@@ -0,0 +1,39 @@
+# WebCore without the inspector (USE_INSPECTOR_STUB). The inspector's sources and IDL files are left out,
+# apart from the instrumenting agents, the identifier registry and the public instrumentation entry points,
+# which the remaining WebCore code calls. InspectorStub.cpp defines the page, frame and worker inspector
+# controllers, and InspectorGeneratedStub.cpp, generated from the inspector headers, defines the
+# instrumentation hooks and the canvas call tracer's argument processors.
+
+set(WebCore_INSPECTOR_STUB_IDL_EXCLUDED "^inspector/(CommandLineAPIHost|InspectorAudit[A-Za-z]*|InspectorFrontendHost)\.idl$")
+
+list(APPEND WebCore_UNIFIED_SOURCE_EXCLUDES
+    "^inspector/"
+)
+
+set(WebCore_INSPECTOR_STUB_EXCLUDED_IDL_FILES ${WebCore_IDL_FILES})
+list(FILTER WebCore_INSPECTOR_STUB_EXCLUDED_IDL_FILES INCLUDE REGEX "${WebCore_INSPECTOR_STUB_IDL_EXCLUDED}")
+foreach (_idl IN LISTS WebCore_INSPECTOR_STUB_EXCLUDED_IDL_FILES)
+    get_filename_component(_name "${_idl}" NAME_WE)
+    list(APPEND WebCore_UNIFIED_SOURCE_EXCLUDES "^JS${_name}\.cpp")
+endforeach ()
+list(FILTER WebCore_IDL_FILES EXCLUDE REGEX "${WebCore_INSPECTOR_STUB_IDL_EXCLUDED}")
+
+add_custom_command(
+    OUTPUT ${WebCore_DERIVED_SOURCES_DIR}/InspectorGeneratedStub.cpp
+    DEPENDS
+        ${WEBCORE_DIR}/inspector/InspectorCanvasArguments.h
+        ${WEBCORE_DIR}/inspector/InspectorInstrumentation.h
+        ${WEBCORE_DIR}/inspector/stub/generate-inspector-stub.py
+    COMMAND ${PYTHON_EXECUTABLE} ${WEBCORE_DIR}/inspector/stub/generate-inspector-stub.py
+        ${WEBCORE_DIR}/inspector/InspectorInstrumentation.h ${WEBCORE_DIR}/inspector/InspectorCanvasArguments.h
+        ${WebCore_DERIVED_SOURCES_DIR}/InspectorGeneratedStub.cpp
+    VERBATIM)
+
+list(APPEND WebCore_SOURCES
+    inspector/InspectorIdentifierRegistry.cpp
+    inspector/InspectorInstrumentationPublic.cpp
+    inspector/InspectorInstrumentationWebKit.cpp
+    inspector/InstrumentingAgents.cpp
+    inspector/stub/InspectorStub.cpp
+    ${WebCore_DERIVED_SOURCES_DIR}/InspectorGeneratedStub.cpp
+)
