+// The href property is registered under both href and xlink:href. Its serialization belongs to xlink:href only
+// when that is the element's sole href attribute.
+static const QualifiedName& synchronizedAttributeName(const SVGElement& element, const QualifiedName& name)
+{
+    if (!name.matches(SVGNames::hrefAttr) && !name.matches(XLinkNames::hrefAttr))
+        return name;
+    if (!element.hasAttributeWithoutSynchronization(SVGNames::hrefAttr) && element.hasAttributeWithoutSynchronization(XLinkNames::hrefAttr))
+        return XLinkNames::hrefAttr;
+    return SVGNames::hrefAttr;
+}
+
 void SVGElement::synchronizeAttribute(const QualifiedName& name)
 {
     // If the value of the property has changed, serialize the new value to the attribute.
     if (auto value = propertyRegistry().synchronize(name)) {
+        const auto& target = synchronizedAttributeName(*this, name);
         // If the serialized value is empty and the attribute doesn't exist,
         // don't recreate it. This handles the case where the attribute was
         // explicitly removed after the list was emptied.
-        if (value->isEmpty() && !hasAttribute(name))
+        if (value->isEmpty() && !hasAttribute(target))
             return;
 
-        setSynchronizedLazyAttribute(name, AtomString { *value });
+        setSynchronizedLazyAttribute(target, AtomString { *value });
     }
 }
 
@@ -575,7 +588,7 @@ void SVGElement::synchronizeAllAttributes()
     // the properties which have changed but not committed yet.
     auto map = propertyRegistry().synchronizeAllAttributes();
     for (const auto& entry : map)
-        setSynchronizedLazyAttribute(entry.key, AtomString { entry.value });
+        setSynchronizedLazyAttribute(synchronizedAttributeName(*this, entry.key), AtomString { entry.value });
 }
 
