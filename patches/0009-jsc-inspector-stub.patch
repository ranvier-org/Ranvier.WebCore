diff --git a/Source/JavaScriptCore/inspector/stub/InspectorStub.cmake b/Source/JavaScriptCore/inspector/stub/InspectorStub.cmake
new file mode 100644
index 0000000..bb9a393
--- /dev/null
+++ b/Source/JavaScriptCore/inspector/stub/InspectorStub.cmake
@@ -0,0 +1,14 @@
+# JavaScriptCore without the inspector (USE_JSC_INSPECTOR_STUB). The agents, injected scripts, protocol
+# dispatchers, frontend router and global object inspector controller are left out. The console's
+# arguments, call stacks and messages and the protocol objects remain, for the console clients and
+# WebCore. InspectorStub.cpp defines the members the remaining code calls.
+
+list(APPEND JavaScriptCore_UNIFIED_SOURCE_EXCLUDES
+    "^inspector/agents/"
+    "^inspector/(ContentSearchUtilities|InjectedScript[A-Za-z]*|InspectorAgentRegistry|InspectorBackendDispatchers?|InspectorFrontendDispatchers|InspectorFrontendRouter|InspectorTarget)\.cpp$"
+    "^inspector/(JSGlobalObject(ConsoleClient|Debugger|InspectorController)|JSInjectedScriptHost[A-Za-z]*|JSJavaScriptCallFrame[A-Za-z]*|JavaScriptCallFrame)\.cpp$"
+)
+
+list(APPEND JavaScriptCore_SOURCES
+    inspector/stub/InspectorStub.cpp
+)
diff --git a/Source/JavaScriptCore/inspector/stub/InspectorStub.cpp b/Source/JavaScriptCore/inspector/stub/InspectorStub.cpp
new file mode 100644
index 0000000..93076c4
--- /dev/null
+++ b/Source/JavaScriptCore/inspector/stub/InspectorStub.cpp
@@ -0,0 +1,89 @@
+// The JavaScriptCore inspector members the remaining code references, for a build without the inspector
+// (USE_JSC_INSPECTOR_STUB).
+//
+// No frontend ever connects and no debugger agent is ever created. Queries answer as they do with no
+// frontend connected, objects WebCore's inspector controllers hold are constructed and destroyed, and
+// every member that serves a frontend or an injected script is a release assertion.
+
+#include "config.h"
+
+#include "InjectedScript.h"
+#include "InjectedScriptHost.h"
+#include "InjectedScriptManager.h"
+#include "InspectorAgentBase.h"
+#include "InspectorAgentRegistry.h"
+#include "InspectorBackendDispatcher.h"
+#include "InspectorDebuggerAgent.h"
+#include "InspectorFrontendDispatchers.h"
+#include "InspectorFrontendRouter.h"
+#include "JSInjectedScriptHost.h"
+#include "JSJavaScriptCallFrame.h"
+#include <wtf/TZoneMallocInlines.h>
+
+namespace Inspector {
+
+void ConsoleFrontendDispatcher::messageAdded(Ref<Protocol::Console::ConsoleMessage>&&) { RELEASE_ASSERT_NOT_REACHED(); }
+void ConsoleFrontendDispatcher::messageRepeatCountUpdated(int, std::optional<double>&&) { RELEASE_ASSERT_NOT_REACHED(); }
+
+InjectedScriptBase::~InjectedScriptBase() = default;
+InjectedScript::~InjectedScript() = default;
+RefPtr<Protocol::Runtime::RemoteObject> InjectedScript::wrapObject(JSC::JSValue, const String&, bool) const { RELEASE_ASSERT_NOT_REACHED(); }
+RefPtr<Protocol::Runtime::RemoteObject> InjectedScript::wrapTable(JSC::JSValue, JSC::JSValue) const { RELEASE_ASSERT_NOT_REACHED(); }
+RefPtr<Protocol::Runtime::RemoteObject> InjectedScript::wrapJSONString(const String&, const String&, bool) const { RELEASE_ASSERT_NOT_REACHED(); }
+
+// WebCore's page, frame and worker inspector controllers each hold an agent registry, a frontend router, a
+// backend dispatcher and an injected script manager.
+
+AgentRegistry::AgentRegistry() = default;
+
+AgentRegistry::~AgentRegistry()
+{
+    for (auto& agent : m_agents)
+        agent->discardAgent();
+}
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(FrontendRouter);
+
+Ref<FrontendRouter> FrontendRouter::create()
+{
+    return adoptRef(*new FrontendRouter);
+}
+
+BackendDispatcher::BackendDispatcher(Ref<FrontendRouter>&& router, BackendDispatcher* fallback)
+    : m_frontendRouter(WTF::move(router))
+    , m_fallbackDispatcher(fallback)
+{
+}
+
+Ref<BackendDispatcher> BackendDispatcher::create(Ref<FrontendRouter>&& router, BackendDispatcher* fallback)
+{
+    return adoptRef(*new BackendDispatcher(WTF::move(router), fallback));
+}
+
+InjectedScriptHost::InjectedScriptHost() = default;
+InjectedScriptHost::~InjectedScriptHost() = default;
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(InjectedScriptManager);
+
+InjectedScriptManager::InjectedScriptManager(InspectorEnvironment& environment, Ref<InjectedScriptHost>&& injectedScriptHost)
+    : m_environment(&environment)
+    , m_injectedScriptHost(WTF::move(injectedScriptHost))
+    , m_nextInjectedScriptId(1)
+{
+}
+
+InjectedScriptManager::~InjectedScriptManager() = default;
+
+void InjectedScriptManager::connect() { RELEASE_ASSERT_NOT_REACHED(); }
+void InjectedScriptManager::disconnect() { RELEASE_ASSERT_NOT_REACHED(); }
+void InjectedScriptManager::discardInjectedScripts() { RELEASE_ASSERT_NOT_REACHED(); }
+void InjectedScriptManager::didCreateInjectedScript(const InjectedScript&) { RELEASE_ASSERT_NOT_REACHED(); }
+InjectedScript InjectedScriptManager::injectedScriptFor(JSC::JSGlobalObject*) { RELEASE_ASSERT_NOT_REACHED(); }
+
+AsyncStackTrace* InspectorDebuggerAgent::currentParentStackTrace() const { return nullptr; }
+
+// The heap keeps a cell type for each, and no cell of either type is allocated.
+void JSInjectedScriptHost::destroy(JSC::JSCell*) { RELEASE_ASSERT_NOT_REACHED(); }
+void JSJavaScriptCallFrame::destroy(JSC::JSCell*) { RELEASE_ASSERT_NOT_REACHED(); }
+
+} // namespace Inspector
