diff --git a/Source/WebCore/dom/DataTransfer.cpp b/Source/WebCore/dom/DataTransfer.cpp
--- a/Source/WebCore/dom/DataTransfer.cpp
+++ b/Source/WebCore/dom/DataTransfer.cpp
@@ -266,7 +266,10 @@ bool DataTransfer::allowsFileAccess() const
 {
 #if PLATFORM(COCOA)
     return !forDrag() || forFileDrag();
-#elif PLATFORM(GTK) || PLATFORM(WPE)
+#elif PLATFORM(WPE)
+    return m_pasteboard && m_pasteboard->fileContentState() == Pasteboard::FileContentState::InMemoryImage
+        && (!forDrag() || m_pasteboard->isStatic());
+#elif PLATFORM(GTK)
     // File drag access is disabled until https://webkit.org/b/271957 is resolved for GTK/WPE ports.
