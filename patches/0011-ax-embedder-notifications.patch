+# Hands each accessibility notification AXObjectCache delivers to the page's ChromeClient as well, on every
+# port, for an embedder that presents the accessibility tree through the platform API itself.
+option(USE_AX_EMBEDDER_NOTIFICATIONS "Hand AXObjectCache notifications to ChromeClient::postAccessibilityNotification" OFF)
+if (USE_AX_EMBEDDER_NOTIFICATIONS)
+    SET_AND_EXPOSE_TO_BUILD(USE_AX_EMBEDDER_NOTIFICATIONS ON)
+endif ()
