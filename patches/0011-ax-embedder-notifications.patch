+
+void AXObjectCache::postEmbedderTextNotification(AccessibilityObject* object, AXNotification notification)
+{
+    if (!object)
+        return;
+    // A text field's own object, rather than its inner editor's.
+    if (RefPtr observable = object->observableObject())
+        postEmbedderNotification(*observable, notification);
+    else
+        postEmbedderNotification(*object, notification);
+}
+#endif
