+static bool s_paintsLayersOnGPU;
+
+void BitmapTexture::setPaintsLayersOnGPU(bool enabled)
+{
+    s_paintsLayersOnGPU = enabled;
+}
+
+bool BitmapTexture::paintsLayersOnGPU()
+{
+    return s_paintsLayersOnGPU;
+}
+
+bool BitmapTexture::canPaintLayersOnGPU()
+{
+#if PLATFORM(WIN) || PLATFORM(WPE)
+    // WPE creates the thread's Skia GL context on first use; the Windows port leaves it to the embedder, as WebKit's
+    // threaded compositor installs one. A context that cannot be created is not tried again.
+    static bool unavailable;
+    if (unavailable)
+        return false;
+    auto& display = PlatformDisplay::sharedDisplay();
+    auto* previous = GLContext::current();
+#if PLATFORM(WIN)
+    if (!display.skiaGLContext())
+        display.setSkiaGLContextForCurrentThread(GLContext::createOffscreen(display));
+#endif
+    bool available = display.skiaGLContext() && display.skiaGrContext();
+    if (previous && GLContext::current() != previous)
+        previous->makeContextCurrent();
+    unavailable = !available;
+    return available;
+#else
+    return false;
+#endif
+}
+
+void BitmapTexture::releaseLayerPaintingContext()
+{
+#if PLATFORM(WIN)
+    if (PlatformDisplay::sharedDisplay().skiaGLContext())
+        PlatformDisplay::sharedDisplay().setSkiaGLContextForCurrentThread(nullptr);
+#endif
+}
+
+// Rasterizes the layer straight into this texture with Ganesh, in the thread's Skia GL context, and makes the
+// current (compositing) context wait for that work on the GPU. Returns false, with the current context unchanged
+// and nothing painted, when the CPU path should paint instead.
+bool BitmapTexture::updateContentsOnGPU(GraphicsLayer* sourceLayer, const IntRect& targetRect, const IntPoint& offset, float scale)
+{
+    if (!s_paintsLayersOnGPU || m_renderTarget != GL_TEXTURE_2D || m_flags.contains(Flags::UseBGRALayout) || !m_id)
+        return false;
+#if USE(GBM)
+    if (m_memoryMappedGPUBuffer)
+        return false;
+#endif
+    auto* compositingContext = GLContext::current();
+    auto& display = PlatformDisplay::sharedDisplay();
+    auto* skiaContext = display.skiaGLContext();
+    if (!compositingContext || !skiaContext || skiaContext == compositingContext)
+        return false;
+    // Skia renders in another context of the same share group: the texture's pending uploads must reach it first.
+    glFlush();
+    if (!skiaContext->makeContextCurrent()) {
+        compositingContext->makeContextCurrent();
+        return false;
+    }
+    auto* grContext = display.skiaGrContext();
+    auto surface = grContext ? createSkiaSurface(grContext) : nullptr;
+    if (!surface) {
+        compositingContext->makeContextCurrent();
+        return false;
+    }
+
+    // Skia writes RGBA. A texture the CPU path filled holds BGRA, which the compositor swizzles as a whole, so its
+    // first GPU paint covers all of it.
+    IntRect paintRect = targetRect;
+    IntPoint paintOffset = offset;
+    if (m_pixelFormat != PixelFormat::RGBA8) {
+        paintRect = IntRect { { }, m_size };
+        paintOffset = offset - toIntSize(targetRect.location());
+    }
+
+    auto* canvas = surface->getCanvas();
+    canvas->save();
+    canvas->clipRect(SkRect::MakeXYWH(paintRect.x(), paintRect.y(), paintRect.width(), paintRect.height()));
+    canvas->clear(SK_ColorTRANSPARENT);
+    {
+        GraphicsContextSkia context(*canvas, RenderingMode::Accelerated, RenderingPurpose::LayerBacking);
+        context.setTextDrawingMode(TextDrawingMode::Fill);
+        FloatRect sourceRect(paintRect);
+        sourceRect.setLocation(paintOffset);
+        sourceRect.scale(1 / scale);
+        context.translate(paintRect.x(), paintRect.y());
+        context.applyDeviceScaleFactor(scale);
+        context.translate(-sourceRect.x(), -sourceRect.y());
+        sourceLayer->paintGraphicsLayerContents(context, sourceRect);
+    }
+    canvas->restore();
+
+    // Painting can make another context current (an accelerated image buffer's); flush in Skia's.
+    skiaContext->makeContextCurrent();
+    auto fence = SkiaUtilities::flushAndSubmitSurfaceWithFence(grContext, surface.get());
+    surface = nullptr;
+    // The fence is waited on from the compositing context, and a wait without EGL_SYNC_FLUSH_COMMANDS_BIT on a fence
+    // its own context never flushed does not return (ANGLE's D3D11 backend spins on it).
+    glFlush();
+    if (!compositingContext->makeContextCurrent())
+        return true;
+    if (fence)
+        fence->serverWait();
+    m_pixelFormat = PixelFormat::RGBA8;
+    return true;
+}
 #endif
 
 } // namespace WebCore
