+// Ranvier: separate invalidations repaint separately, so a scrolled strip and a fixed element at the other end of the
+// layer repaint two small rectangles rather than the rectangle that bounds them. Past a few, they merge.
+void GraphicsLayerTextureMapper::addNeedsDisplayRect(const FloatRect& rect)
+{
+    if (rect.isEmpty())
+        return;
+    for (auto& existing : m_needsDisplayRects) {
+        if (existing.contains(rect))
+            return;
+    }
+    m_needsDisplayRects.removeAllMatching([&](auto& existing) { return rect.contains(existing); });
+    m_needsDisplayRects.append(rect);
+    static constexpr size_t maximumRects = 8;
+    if (m_needsDisplayRects.size() > maximumRects) {
+        FloatRect bounds;
+        for (auto& existing : m_needsDisplayRects)
+            bounds.unite(existing);
+        m_needsDisplayRects = { bounds };
+    }
+}
