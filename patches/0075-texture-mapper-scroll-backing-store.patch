+bool GraphicsLayerTextureMapper::scrollBackingStore(const IntSize& delta, const IntRect& rect)
+{
+    if (!m_backingStore || m_needsDisplay || !shouldHaveBackingStore())
+        return false;
+    float scale = pageScaleFactor() * deviceScaleFactor();
+    FloatSize scaledDelta { delta };
+    scaledDelta.scale(scale);
+    FloatRect scaledRect { rect };
+    scaledRect.scale(scale);
+    IntSize deviceDelta { roundedIntSize(scaledDelta) };
+    IntRect deviceRect { enclosingIntRect(scaledRect) };
+    if (FloatSize { deviceDelta } != scaledDelta || FloatRect { deviceRect } != scaledRect)
+        return false;
+    m_backingStore->updateContentsScale(scale);
+    if (!m_backingStore->scrollContents(deviceDelta, deviceRect))
+        return false;
+    // Pending partial repaints are in the old coordinates: they repaint where they were and where they moved.
+    auto pending = m_needsDisplayRects;
+    for (auto rect : pending) {
+        rect.move(delta);
+        addNeedsDisplayRect(rect);
+    }
+    return true;
 }
 
