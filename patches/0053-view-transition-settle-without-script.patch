+// An embedder that disallows VM entry never runs a JavaScript promise reaction. A transition whose update callback is
+// absent or the embedder's settles its promises through C++ microtasks there, which run at microtask checkpoints.
+static bool settlesWithoutScript(Document& document, ViewTransitionUpdateCallback* callback)
+{
+    return (!callback || !callback->isJSViewTransitionUpdateCallback()) && document.vm().disallowVMEntryCount;
+}
+
+// Settles finished as updateCallbackDone settled: fulfilled, or rejected with its reason.
+static void settleFinished(DOMPromise& updateCallbackDone, DeferredPromise& finished)
+{
+    switch (updateCallbackDone.status()) {
+    case DOMPromise::Status::Fulfilled:
+        finished.resolve();
+        break;
+    case DOMPromise::Status::Rejected:
+        finished.rejectWithCallback([&] (auto&) {
+            return updateCallbackDone.result();
+        }, RejectAsHandled::Yes);
+        break;
+    case DOMPromise::Status::Pending:
+        break;
+    }
+}
