{
    "comment": [
        "The interfaces gen/domgen.py exports, one C function per IDL member: what a native app's UI uses.",
        "Each interface takes its own members, those of its partial interfaces and those of the mixins it includes,",
        "except partials and mixins declared under the directories of skipDirectories, which hold browser features.",
        "exclude lists members left out by name, as Interface.member, or member alone for every interface.",
        "atomArguments lists operations whose C++ takes AtomString for string arguments the IDL does not mark [AtomString].",
        "Members whose types or extended attributes the generator does not map are left out on their own and listed",
        "in gen/dom-report.txt."
    ],
    "interfaces": [
        "Node",
        "CharacterData",
        "Text",
        "Comment",
        "DocumentFragment",
        "ShadowRoot",
        "Document",
        "HTMLDocument",
        "DOMImplementation",
        "Element",
        "Attr",
        "NamedNodeMap",
        "HTMLElement",
        "HTMLAnchorElement",
        "HTMLBodyElement",
        "HTMLButtonElement",
        "HTMLDetailsElement",
        "HTMLDialogElement",
        "HTMLDivElement",
        "HTMLFieldSetElement",
        "HTMLFormElement",
        "HTMLHeadElement",
        "HTMLImageElement",
        "HTMLInputElement",
        "HTMLLabelElement",
        "HTMLLegendElement",
        "HTMLLIElement",
        "HTMLMeterElement",
        "HTMLOListElement",
        "HTMLOptGroupElement",
        "HTMLOptionElement",
        "HTMLOutputElement",
        "HTMLParagraphElement",
        "HTMLProgressElement",
        "HTMLSelectElement",
        "HTMLSlotElement",
        "HTMLSpanElement",
        "HTMLTextAreaElement",
        "HTMLTemplateElement",
        "HTMLUListElement",
        "CSSStyleDeclaration",
        "DOMTokenList",
        "DOMStringMap",
        "AbstractRange",
        "StaticRange",
        "Range",
        "DOMSelection",
        "DOMRectReadOnly",
        "DOMRect",
        "NodeList",
        "RadioNodeList",
        "HTMLCollection",
        "ValidityState",
        "Event",
        "UIEvent",
        "MouseEvent",
        "PointerEvent",
        "WheelEvent",
        "KeyboardEvent",
        "FocusEvent",
        "InputEvent",
        "CompositionEvent"
    ],
    "skipDirectories": [
        "Modules/",
        "bindings/scripts/test/",
        "testing/"
    ],
    "customGetters": [
        "Node.nodeType"
    ],
    "contract": {
        "htmlTags": "html/HTMLTagNames.in",
        "svgTags": "svg/svgtags.in",
        "interfaces": [
            "SVGElement", "SVGSVGElement", "CSSAnimationEvent", "CSSTransitionEvent", "BeforeUnloadEvent",
            "CSSStyleSheet", "CustomElementRegistry", "ClipboardEvent", "DragEvent", "ErrorEvent", "FileList",
            "FormDataEvent", "GamepadEvent", "HTMLFormControlsCollection", "HTMLOptionsCollection", "HashChangeEvent",
            "MediaEncryptedEvent", "MediaError", "MediaKeys", "PageRevealEvent", "PageSwapEvent", "PageTransitionEvent",
            "PictureInPictureEvent", "PopStateEvent", "ProgressEvent", "PromiseRejectionEvent", "RemotePlayback",
            "SecurityPolicyViolationEvent", "StorageEvent", "StylePropertyMap", "SubmitEvent", "TextTrack",
            "TextTrackList", "TimeRanges", "ToggleEvent", "TouchEvent"
        ],
        "aliases": {
            "CSSAnimationEvent": "AnimationEvent",
            "CSSTransitionEvent": "TransitionEvent"
        },
        "mixins": {
            "AriaAttributes": "ARIAMixin",
            "ChildNode": "ChildNode",
            "ParentNode": "ParentNode",
            "NonDocumentTypeChildNode": "NonDocumentTypeChildNode",
            "GlobalEventHandlers": "GlobalEventHandlers",
            "ElementCSSInlineStyle": "ElementCSSInlineStyle",
            "ElementContentEditable": "ElementContentEditable",
            "HTMLHyperlinkElementUtils": "HTMLHyperlinkElementUtils",
            "HTMLOrSVGOrMathMLElement": "HTMLOrSVGElement",
            "LinkStyle": "LinkStyle",
            "PopoverInvokerElement": "PopoverTargetAttributes",
            "Slotable": "Slottable"
        }
    },
    "castVia": {
        "RadioNodeList": "LiveNodeList"
    },
    "atomArguments": [
        "HTMLFormElement.namedItem",
        "DocumentFragment.getElementById",
        "HTMLCollection.namedItem",
        "HTMLSelectElement.namedItem"
    ],
    "exclude": [
        "DOMRect.x",
        "DOMRect.y",
        "DOMRect.width",
        "DOMRect.height",
        "ElementCreationOptions.customElementRegistry",
        "ImportNodeOptions.customElementRegistry",
        "Document.cookie",
