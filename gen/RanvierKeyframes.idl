// The native transport of a Web Animations keyframes object: its keyframe-sequence form, as a JavaScript caller
// writes [{ offset, easing, composite, opacity: "0" }, ...]. host/dom/RanvierKeyframes.h converts a sequence of these
// to that JavaScript array, so WebKit's own keyframe processing reads it.

dictionary KeyframeProperty {
    // An IDL attribute name (opacity, transform, backgroundColor, cssFloat) or a custom property name (--x).
    required DOMString name;
    required DOMString value;
};

dictionary Keyframe {
    // Absent: a null offset, spaced evenly by keyframe processing.
    double offset;
    // Absent: "linear".
    DOMString easing;
    // Absent: "auto". Otherwise "replace", "add", "accumulate" or "auto".
    DOMString composite;
    sequence<KeyframeProperty> properties = [];
};
