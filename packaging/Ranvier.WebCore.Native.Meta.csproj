<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Ranvier.WebCore.Native</PackageId>
    <!-- This project has no sources, and the default glob would take the generated files in cpu/obj and gpu/obj. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Authors>Ranvier</Authors>
    <Description>Native WebCore host for Windows x64/ARM64, Linux x64/ARM64 and macOS ARM64: accelerated compositing, GPU painting and native GPU frames, painting on the CPU where no GPU context can be created, and the CPU host for Windows ARM64. Restore selects the native assets for the application's runtime.</Description>
    <PackageTags>webkit;webcore;native;gpu;ranvier</PackageTags>
    <PackageLicenseFile>NOTICE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ranvier.WebCore.Native.win-x64" Version="[$(Version)]" />
    <PackageReference Include="Ranvier.WebCore.Native.linux-x64" Version="[$(Version)]" />
    <PackageReference Include="Ranvier.WebCore.Native.linux-arm64" Version="[$(Version)]" />
    <PackageReference Include="Ranvier.WebCore.Native.osx-arm64" Version="[$(Version)]" />
    <!-- Windows ARM64 has no GPU build; the CPU host of the same version serves it. -->
    <PackageReference Include="Ranvier.WebCore.Native.Cpu.win-arm64" Version="[$(Version)]" />
    <None Include="../NOTICE.md" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
