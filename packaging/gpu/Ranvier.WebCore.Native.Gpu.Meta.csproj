<Project Sdk="Microsoft.NET.Sdk">
  <!-- The GPU aggregate's former name, kept so existing references restore: the GPU runtimes are the default
       Ranvier.WebCore.Native package now, and this package only depends on it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Ranvier.WebCore.Native.Gpu</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Authors>Ranvier</Authors>
    <Description>Former name of Ranvier.WebCore.Native, on which it depends: reference Ranvier.WebCore.Native instead.</Description>
    <PackageTags>webkit;webcore;native;gpu;ranvier</PackageTags>
    <PackageLicenseFile>NOTICE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ranvier.WebCore.Native" Version="[$(Version)]" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
