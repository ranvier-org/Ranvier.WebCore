<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Ranvier.WebCore.Native.Gpu</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Authors>Ranvier</Authors>
    <Description>GPU native WebCore host for Windows x64, Linux x64/ARM64 and macOS ARM64, with the Slim host for Windows ARM64. Restore selects the native assets for the application's runtime.</Description>
    <PackageTags>webkit;webcore;native;gpu;ranvier</PackageTags>
    <PackageLicenseFile>NOTICE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ranvier.WebCore.Native.Gpu.win-x64" Version="[$(Version)]" />
    <PackageReference Include="Ranvier.WebCore.Native.Gpu.linux-x64" Version="[$(Version)]" />
    <PackageReference Include="Ranvier.WebCore.Native.Gpu.linux-arm64" Version="[$(Version)]" />
    <PackageReference Include="Ranvier.WebCore.Native.Gpu.osx-arm64" Version="[$(Version)]" />
    <!-- Windows ARM64 has no GPU build; the Slim host of the same version serves it. -->
    <PackageReference Include="Ranvier.WebCore.Native.win-arm64" Version="[$(Version)]" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
